<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by scripts/New-LegacyProjects.ps1. MacroHID 1.6.0 playback code (v1.6.0), unchanged except the
       files in patched-files.txt, compiled as one assembly so it can run next to the current runtime. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MacroHid.Legacy.V1_6_0</AssemblyName>
    <RootNamespace>MacroHid.Legacy.V1_6_0</RootNamespace>
    <DefineConstants>$(DefineConstants);LEGACY_BACKGROUND_OPTIONS;LEGACY_LAST_ERROR;LEGACY_MASK_WARMUP;LEGACY_MASK_CLEAR_SHUTDOWN;LEGACY_EXTERNAL_HOOK</DefineConstants>
    <!-- The release's code as it was: its warnings are not ours to fix. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS0649;CS0169;CS1998;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS8765;CS8767;CA1416;CA2022;NU1701</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Native\**" />
    <None Remove="Native\**" />
    <Compile Include="..\Bridge\LegacyBridge.cs" Link="LegacyBridge.cs" />
    <Compile Include="..\Bridge\LegacyExternalStep.cs" Link="LegacyExternalStep.cs" />
    <AssemblyMetadata Include="LegacyVersion" Value="1.6.0" />
    <AssemblyMetadata Include="LegacySuffix" Value="v1_6_0" />
    <AssemblyMetadata Include="LegacyStepTypes" Value="clock.shift;comment;consumer.down;consumer.tap;consumer.up;frame.lock;key.down;key.tap;key.text;key.up;macro.call;mouse.click;mouse.down;mouse.move;mouse.up;mouse.wheel;net.limit;ocr.click;ocr.extract-text;parallel;parallel.branch;pixel.when;repeat;sequence.stop-all;sequence.stop-current;sequence.stop-iteration;text.when;wait;weak.net;window.activate" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroHid.LegacyContract\MacroHid.LegacyContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\WeakNet\Native\WinDivert.dll" LogicalName="WinDivert.dll" />
    <EmbeddedResource Include="Runtime\WeakNet\Native\WinDivert64.sys" LogicalName="WinDivert64.sys" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetLimiter" Version="5.3.18" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built by scripts/Build-LegacyNative.ps1 from Native\ (the release's own native source). -->
    <None Include="Native\x64\Release\MacroHid.NativePlayback.v1_6_0.dll" Condition="Exists('Native\x64\Release\MacroHid.NativePlayback.v1_6_0.dll')"
          Link="MacroHid.NativePlayback.v1_6_0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
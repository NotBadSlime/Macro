<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by scripts/New-LegacyProjects.ps1. MacroHID 1.4.0 playback code (v1.4.0), unchanged except the
       files in patched-files.txt, compiled as one assembly so it can run next to the current runtime. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>MacroHid.Legacy.V1_4_0</AssemblyName>
    <RootNamespace>MacroHid.Legacy.V1_4_0</RootNamespace>
    <DefineConstants>$(DefineConstants);LEGACY_EXTERNAL_HOOK</DefineConstants>
    <!-- The release's code as it was: its warnings are not ours to fix. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS0649;CS0169;CS1998;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS8765;CS8767;CA1416;CA2022;NU1701</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Native\**" />
    <None Remove="Native\**" />
    <Compile Include="..\Bridge\LegacyBridge.cs" Link="LegacyBridge.cs" />
    <Compile Include="..\Bridge\LegacyExternalStep.cs" Link="LegacyExternalStep.cs" />
    <AssemblyMetadata Include="LegacyVersion" Value="1.4.0" />
    <AssemblyMetadata Include="LegacySuffix" Value="v1_4_0" />
    <AssemblyMetadata Include="LegacyStepTypes" Value="comment;consumer.down;consumer.tap;consumer.up;key.down;key.tap;key.text;key.up;macro.call;mouse.click;mouse.down;mouse.move;mouse.up;mouse.wheel;ocr.click;ocr.extract-text;pixel.when;repeat;sequence.stop-all;sequence.stop-current;sequence.stop-iteration;wait;window.activate" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroHid.LegacyContract\MacroHid.LegacyContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built by scripts/Build-LegacyNative.ps1 from Native\ (the release's own native source). -->
    <None Include="Native\x64\Release\MacroHid.NativePlayback.v1_4_0.dll" Condition="Exists('Native\x64\Release\MacroHid.NativePlayback.v1_4_0.dll')"
          Link="MacroHid.NativePlayback.v1_4_0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
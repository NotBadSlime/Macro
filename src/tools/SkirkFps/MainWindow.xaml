<Window x:Class="SkirkFps.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="YSRExtend · YSR 解帧器扩展" Width="820" Height="720" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#15151B" Foreground="#ECE9F5" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStyle="None" Icon="Assets/skirk.ico" PreviewKeyDown="Capture_KeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
 <Border Background="#15151B" BorderBrush="#393741" BorderThickness="1">
 <Grid><Grid.RowDefinitions><RowDefinition Height="180" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid ClipToBounds="True" MouseLeftButtonDown="Header_MouseDown">
   <Image Source="Assets/skirk-background.png" Stretch="UniformToFill" />
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F015151B" Offset="0" /><GradientStop Color="#A015151B" Offset="0.5" /><GradientStop Color="#1015151B" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <StackPanel Margin="28,35,0,0" VerticalAlignment="Top"><TextBlock Text="YSRExtend" Foreground="#C4B2F5" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="把帧率交给快捷键" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,8" /></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"><Button Content="−" Click="Minimize_Click" Padding="12,3" Margin="0,0,6,0" ToolTip="最小化到任务栏" /><Button Content="×" Click="Close_Click" Padding="12,3" ToolTip="恢复帧率并退出" /></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="28,22,28,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="ConnectionText" Text="等待 YSR 连接" Foreground="#B5ABCA" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock x:Name="CurrentFpsText" Text="—" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="FPS 上限" Foreground="#8F899F" Margin="9,0,0,4" VerticalAlignment="Bottom" /></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="恢复原帧率" Click="Restore_Click" Margin="0,0,10,0" /><Button x:Name="ListenButton" Content="开始监听" Background="#7964B8" BorderBrush="#A38ADB" Click="Listen_Click" /></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="28,0,28,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="＋ 添加规则" Click="Add_Click" Padding="12,6" /><TextBlock Text="快捷键规则" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
   <Grid Grid.Row="1" Margin="18,0,18,8"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions><TextBlock Text="启用" Foreground="#8F899F" FontSize="12" /><TextBlock Grid.Column="1" Text="快捷键 · 点击录入" Foreground="#8F899F" FontSize="12" /><TextBlock Grid.Column="2" Text="目标帧率" Foreground="#8F899F" FontSize="12" /></Grid>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="RulesList"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#202027" BorderBrush="#34333E" BorderThickness="1" CornerRadius="12" Padding="18,10" Margin="0,0,0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Enabled}" Click="Enabled_Click" ToolTip="参与快捷键监听" />
      <Button Grid.Column="1" Content="{Binding HotkeyText}" Click="Capture_Click" HorizontalAlignment="Left" MinWidth="150" Height="38" ToolTip="支持单键与 Ctrl / Alt / Shift / Win 组合，Esc 取消" />
      <TextBox Grid.Column="2" Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" Width="84" Height="38" HorizontalAlignment="Left" PreviewGotKeyboardFocus="Edit_Focus" LostFocus="Edit_LostFocus" ToolTip="1–1000 的整数" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="应用" Click="Apply_Click" Padding="12,8" /><Button Content="×" Click="Delete_Click" Padding="10,8" Margin="8,0,0,0" ToolTip="删除规则" /></StackPanel>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="3" Margin="28,16,28,22">
   <Border BorderBrush="#34333E" BorderThickness="0,1,0,0" Padding="0,16,0,0"><DockPanel><Button x:Name="RestoreKeyButton" DockPanel.Dock="Right" Click="RestoreKey_Click" Padding="12,6" /><TextBlock Text="恢复快捷键" VerticalAlignment="Center" Foreground="#B3ACC4" /></DockPanel></Border>
   <TextBlock x:Name="StatusText" Text="先启动 YSR 和游戏，再开启监听。配置自动保存。" Foreground="#918A9F" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
  </StackPanel>
 </Grid></Border>
</Window>

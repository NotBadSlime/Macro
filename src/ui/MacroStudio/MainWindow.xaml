<Window x:Class="MacroStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MacroStudio.Controls"
        Title="MacroHID Studio · UI Edition"
        Height="900"
        Width="1440"
        MinHeight="560"
        MinWidth="1040"
        Icon="Assets/AppIcon.ico"
        Background="{DynamicResource PageBackground}"
        FontFamily="Segoe UI Variable, Segoe UI"
        UseLayoutRounding="True"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragOver="MainWindow_PreviewDragOver"
        PreviewDrop="MainWindow_PreviewDrop"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="AppShellRoot" Background="{DynamicResource PageBackground}">
        <DockPanel x:Name="StudioWorkspace">
            <Border x:Name="CommandBar"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource StudioChrome}"
                    BorderBrush="{DynamicResource ChromeBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopChromeBar_MouseLeftButtonDown">
                <DockPanel>
                    <DockPanel Margin="16,7,8,7">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="31" Height="31" CornerRadius="6" Margin="0,0,10,0"
                                    Background="{DynamicResource StudioBrandSurface}"
                                    BorderBrush="{DynamicResource StudioChromeEdge}" BorderThickness="1">
                                <Grid>
                                    <Viewbox Width="24" Height="24">
                                        <Path Data="M2,15 L7,15 10,6 14,21 17,11 22,11"
                                              Stroke="{DynamicResource StudioBrandMark}" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="MacroHID Studio" Foreground="{DynamicResource PrimaryText}"
                                           FontSize="17" FontWeight="Bold" />
                                <TextBlock x:Name="EditionLabelText" Text="UI 优化版" Foreground="{DynamicResource StudioSignal}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border VerticalAlignment="Center" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OpenButton" Style="{StaticResource CommandBarButton}"
                                            Content="打开宏文件" Tag="&#xE838;" Click="OpenMacro_Click" />
                                    <Button x:Name="SaveButton" Style="{StaticResource CommandBarButton}"
                                            Content="另存当前宏" Tag="&#xE792;" Click="SaveMacro_Click" />
                                    <Button x:Name="ConditionWorkspaceButton" Style="{StaticResource CommandBarButton}"
                                            Content="条件序列" Click="OpenWorkspaceTool_Click" />
                                    <Button x:Name="JsonWorkspaceButton" Style="{StaticResource CommandBarButton}"
                                            Content="JSON" Click="OpenWorkspaceTool_Click" />
                                    <Button x:Name="WindowMenuButton"
                                            Style="{StaticResource CommandBarButton}"
                                            Content="窗口" Tag="&#xE737;"
                                            Click="WindowMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="WindowMenuContext">
                                                <MenuItem x:Name="ShowPanelsMenuItem" Header="显示">
                                                    <MenuItem x:Name="ShowLibraryMenuItem" Header="宏数据库" Tag="library" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowSequenceMenuItem" Header="序列" Tag="sequence" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowPropertiesMenuItem" Header="步骤属性" Tag="properties" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowConditionMenuItem" Header="条件序列" Tag="conditions" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowJsonMenuItem" Header="MCRX JSON" Tag="json" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowActionMenuItem" Header="动作面板" Tag="actions" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                    <MenuItem x:Name="ShowPlaybackMenuItem" Header="播放控制" Tag="playback" IsCheckable="True" Click="WindowPanelVisibility_Click" />
                                                </MenuItem>
                                                <MenuItem x:Name="FloatPanelsMenuItem" Header="浮动">
                                                    <MenuItem Header="宏数据库" Tag="library" Click="FloatPanel_Click" />
                                                    <MenuItem Header="序列" Tag="sequence" Click="FloatPanel_Click" />
                                                    <MenuItem Header="步骤属性" Tag="properties" Click="FloatPanel_Click" />
                                                    <MenuItem Header="条件序列" Tag="conditions" Click="FloatPanel_Click" />
                                                    <MenuItem x:Name="FloatJsonMenuItem" Header="MCRX JSON" Tag="json" Click="FloatPanel_Click" />
                                                    <MenuItem Header="动作面板" Tag="actions" Click="FloatPanel_Click" />
                                                    <MenuItem Header="播放控制" Tag="playback" Click="FloatPanel_Click" />
                                                </MenuItem>
                                                <MenuItem x:Name="DockPanelsMenuItem" Header="停靠">
                                                    <MenuItem Header="宏数据库" Tag="library" Click="DockPanel_Click" />
                                                    <MenuItem Header="序列" Tag="sequence" Click="DockPanel_Click" />
                                                    <MenuItem Header="步骤属性" Tag="properties" Click="DockPanel_Click" />
                                                    <MenuItem Header="条件序列" Tag="conditions" Click="DockPanel_Click" />
                                                    <MenuItem x:Name="DockJsonMenuItem" Header="MCRX JSON" Tag="json" Click="DockPanel_Click" />
                                                    <MenuItem Header="动作面板" Tag="actions" Click="DockPanel_Click" />
                                                    <MenuItem Header="播放控制" Tag="playback" Click="DockPanel_Click" />
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem x:Name="ResetWorkspaceLayoutMenuItem" Header="重置布局" Click="ResetWorkspaceLayout_Click" />
                                                <MenuItem x:Name="BasicControlMenuItem" Header="基础控制" Click="BasicControlMenu_Click" />
                                                <MenuItem x:Name="PrecisionControlMenuItem" Header="精度控制" Click="PrecisionControlMenu_Click" />
                                                <MenuItem x:Name="AdvancedSettingsMenuItem" Header="高级设置" Click="AdvancedSettingsMenu_Click" />
                                                <MenuItem x:Name="GlobalCommandMenuItem" Header="全局命令" Click="GlobalCommandSettings_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PauseListeningButton" Style="{StaticResource CommandBarButton}"
                                    Content="暂停监听" Margin="0,0,4,0" Click="PauseListeningButton_Click" />
                            <TextBlock x:Name="LanguageLabelText" Text="语言" Visibility="Collapsed" />
                            <ComboBox x:Name="LanguageComboBox" Width="96" Height="32" Margin="0,0,3,0"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabelText}"
                                      SelectionChanged="LanguageComboBox_SelectionChanged" />
                            <Button x:Name="ThemeToggleButton" Style="{StaticResource WindowControlButton}"
                                    Content="&#xE706;" Click="ThemeToggle_Click" ToolTip="Toggle theme" />
                            <Rectangle Width="1" Height="20" Margin="5,0" Fill="{DynamicResource StudioChromeEdge}" />
                            <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowControlButton}"
                                    Content="&#xE921;" ToolTip="最小化" Click="MinimizeWindow_Click" />
                            <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButton}"
                                    Content="&#xE922;" ToolTip="最大化" Click="MaximizeWindow_Click" />
                            <Button x:Name="CloseWindowButton" Style="{StaticResource CloseWindowButton}"
                                    Content="&#xE8BB;" ToolTip="关闭" Click="CloseWindow_Click" />
                        </StackPanel>

                        <Button x:Name="CommandSearchButton" Style="{StaticResource StudioSearchButton}"
                                MaxWidth="340" Margin="12,0" Click="CommandSearchButton_Click">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CommandSearchGlyph" DockPanel.Dock="Left" Text="&#xE721;" Margin="0,0,9,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <Border x:Name="CommandSearchBadge" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="5,1" CornerRadius="4"
                                        BorderBrush="{DynamicResource StudioChromeEdge}" BorderThickness="1"
                                        Background="{DynamicResource StudioToolbarSurface}">
                                    <TextBlock Text="Ctrl+K" FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource StudioSignal}" />
                                </Border>
                                <TextBlock x:Name="CommandSearchLabel" Text="查找命令" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </DockPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource StudioStatusSurface}"
                    BorderBrush="{DynamicResource StudioChromeEdge}" BorderThickness="0,1,0,0" Padding="14,3">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="PerformanceStatusText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}" MaxWidth="370" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Rectangle Width="1" Height="14" Margin="9,0,1,0" Fill="{DynamicResource ChromeBorder}" />
                        <Button x:Name="OpenLogsButton" Style="{StaticResource StudioFooterButton}"
                                Tag="&#xE9D5;" Content="打开日志" Click="OpenLogs_Click" />
                        <Button x:Name="UnlockerSettingsButton" Style="{StaticResource StudioFooterButton}"
                                Tag="&#xE713;" Content="解帧器设置" Click="UnlockerSettings_Click" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Left" Width="17" Height="17" Margin="2,0,8,0" VerticalAlignment="Center">
                        <Ellipse Stroke="{Binding Fill, ElementName=StatusDot}" Opacity="0.4" />
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource StudioSuccess}" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryText}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
            </Border>

            <Grid x:Name="WorkspaceRoot" ClipToBounds="True">
                <controls:WorkspaceDockHost x:Name="DockHost" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MainDockRow" Height="*" MinHeight="320" />
                        <RowDefinition x:Name="BottomDockSplitterRow" Height="12" />
                        <RowDefinition x:Name="BottomDockRow" Height="230" MinHeight="160" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftDockColumn" Width="218" MinWidth="174" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="CenterDockColumn" Width="*" MinWidth="420" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="RightDockColumn" Width="550" MinWidth="270" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="LeftDockContent" Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch">
                        <Border x:Name="LibraryToolChrome" Background="{DynamicResource ShellSidebarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Border x:Name="LibraryPART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}" Visibility="Collapsed">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Tag="library" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                            <Button Tag="library" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                        <TextBlock x:Name="LibraryToolTitle" Text="宏数据库" Style="{StaticResource ToolWindowTitle}" />
                                    </DockPanel>
                                </Border>
                                <ContentControl x:Name="LibraryPanelHost">
                                    <controls:MacroLibraryPanel x:Name="LibraryPanel" />
                                </ContentControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <controls:SmoothGridSplitter x:Name="LeftDockSplitter"
                                                 Grid.Row="0"
                                                 Grid.Column="1" Width="7"
                                                 ResizeBehavior="PreviousAndNext"
                                                 Style="{StaticResource AnimatedDockSplitterStyle}" />

                    <Grid x:Name="CenterDockContent" Grid.Row="0" Grid.Column="2" VerticalAlignment="Stretch">
                        <Border x:Name="SequenceToolChrome" Background="{DynamicResource WorkbenchBackground}">
                            <DockPanel>
                                <Border x:Name="SequencePART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}" Visibility="Collapsed">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Tag="sequence" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                            <Button Tag="sequence" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8FD;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                        <TextBlock x:Name="SequenceToolTitle" Text="序列" Style="{StaticResource ToolWindowTitle}" />
                                    </DockPanel>
                                </Border>
                                <ContentControl x:Name="SequencePanelHost">
                                    <Border ClipToBounds="True">
                                        <controls:SequencePanel x:Name="SequencePanelControl"
                                                                AutomationProperties.AutomationId="SequencePanelControl" />
                                    </Border>
                                </ContentControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <controls:SmoothGridSplitter x:Name="RightDockSplitter"
                                                 Grid.Row="0"
                                                 Grid.Column="3" Width="7"
                                                 ResizeBehavior="PreviousAndNext"
                                                 Style="{StaticResource AnimatedDockSplitterStyle}" />

                    <Border x:Name="RightDockContent"
                            Grid.Row="0"
                            Grid.Column="4"
                            Background="{DynamicResource InspectorBackground}"
                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0"
                            ClipToBounds="True">
                        <DockPanel>
                            <Border x:Name="InspectorTabsFrame" DockPanel.Dock="Top" Margin="10,8,10,0"
                                    Background="{DynamicResource InspectorBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
                                <UniformGrid x:Name="RightToolTabs" Rows="1">
                                    <ToggleButton x:Name="PropertiesRightToolButton" Tag="properties" ToolTip="步骤属性"
                                                  Style="{StaticResource RightToolTabStyle}" Click="RightToolButton_Click"
                                                  Content="属性" />
                                    <ToggleButton x:Name="ActionRightToolButton" Tag="actions" ToolTip="动作库"
                                                  Style="{StaticResource RightToolTabStyle}" Click="RightToolButton_Click"
                                                  Content="动作库" />
                                    <ToggleButton x:Name="PlaybackRightToolButton" Tag="playback" ToolTip="播放控制"
                                                  Style="{StaticResource RightToolTabStyle}" Click="RightToolButton_Click"
                                                  Content="播放" />
                                    <ToggleButton x:Name="ConditionRightToolButton" Tag="conditions" ToolTip="条件序列"
                                                  Style="{StaticResource RightToolTabStyle}" Click="RightToolButton_Click"
                                                  Content="条件" />
                                </UniformGrid>
                            </Border>

                            <Grid x:Name="RightToolDeck" Margin="12,9,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="InspectorUpperRow" Height="*" />
                                    <RowDefinition x:Name="InspectorPlaybackRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Border x:Name="PropertiesToolChrome" Grid.ColumnSpan="2">
                                    <DockPanel>
                                        <Border x:Name="PropertiesPART_Header" Tag="PART_Header" DockPanel.Dock="Top"
                                                Style="{StaticResource ToolWindowHeaderStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Tag="properties" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                                    <Button Tag="properties" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                                </StackPanel>
                                                <TextBlock x:Name="PropertiesToolTitle" Text="步骤属性" Style="{StaticResource ToolWindowTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ContentControl x:Name="StepInspectorHost">
                                                <controls:StepInspectorPanel x:Name="WorkspaceStepInspector" Margin="1,8,6,8" />
                                            </ContentControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ConditionToolChrome" Grid.ColumnSpan="2">
                                    <DockPanel>
                                        <Border x:Name="ConditionPART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Tag="conditions" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                                    <Button Tag="conditions" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                                <TextBlock x:Name="ConditionToolTitle" Text="条件序列" Style="{StaticResource ToolWindowTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <ContentControl x:Name="ConditionPanelHost" AutomationProperties.AutomationId="ConditionSequenceColumn">
                                            <controls:ConditionDirectivePanel x:Name="ConditionPanel" />
                                        </ContentControl>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="ActionPaletteToolChrome" Grid.ColumnSpan="2">
                                    <DockPanel>
                                        <Border x:Name="ActionPalettePART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Tag="actions" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                                    <Button Tag="actions" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE8A7;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                                <TextBlock x:Name="ActionPaletteToolTitle" Text="动作库" Style="{StaticResource ToolWindowTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer x:Name="ActionPaletteToolScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False">
                                            <ContentControl x:Name="ActionPaletteHost">
                                                <controls:ActionPalettePanel x:Name="ActionPalette" Margin="1,8,1,6" />
                                            </ContentControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="PlaybackToolChrome" Grid.ColumnSpan="2">
                                    <DockPanel>
                                        <Border x:Name="PlaybackPART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Tag="playback" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                                    <Button Tag="playback" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE768;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                                <TextBlock x:Name="PlaybackToolTitle" Text="宏播放设置" Style="{StaticResource ToolWindowTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer x:Name="PlaybackToolScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False">
                                            <ContentControl x:Name="PlaybackPanelHost">
                                                <controls:PlaybackPanel x:Name="PlaybackPanelControl" Margin="1,8,3,8" />
                                            </ContentControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="BottomDockSplitter"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="5"
                                  Height="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  Cursor="SizeNS"
                                  Style="{StaticResource AnimatedDockSplitterStyle}"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" />

                    <Grid x:Name="BottomDockContent" Grid.Row="2" Grid.ColumnSpan="5" VerticalAlignment="Stretch">
                        <Border x:Name="JsonToolChrome" Style="{StaticResource ToolWindowHostStyle}">
                            <DockPanel>
                                <Border x:Name="JsonPART_Header" Tag="PART_Header" DockPanel.Dock="Top" Style="{StaticResource ToolWindowHeaderStyle}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Tag="json" Content="&#xE740;" ToolTip="浮动" Style="{StaticResource ToolWindowChromeButton}" Click="FloatPanelFromHeader_Click" />
                                            <Button Tag="json" Content="&#xE711;" ToolTip="关闭" Style="{StaticResource ToolWindowChromeButton}" Click="CloseWorkspacePanel_Click" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE943;" Style="{StaticResource ToolWindowHeaderGlyph}" />
                                        <TextBlock x:Name="JsonToolTitle" Text="MCRX JSON" Style="{StaticResource ToolWindowTitle}" />
                                    </DockPanel>
                                </Border>
                                <ContentControl x:Name="JsonPanelHost" Grid.Row="2">
                                    <controls:McrxJsonPanel x:Name="JsonPanel" />
                                </ContentControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </controls:WorkspaceDockHost>
            </Grid>
        </DockPanel>
        <controls:StudioCommandPalette x:Name="CommandPalette" Visibility="Collapsed" />
    </Grid>
</Window>

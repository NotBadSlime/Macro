<UserControl x:Class="MacroStudio.Controls.MacroLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExplorerRenameTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate x:Key="MacroTreeNodeTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="8,7" MouseLeftButtonDown="MacroTreeNode_MouseLeftButtonDown">
                <Border Margin="-5,-4"
                        Background="{DynamicResource Selection}"
                        BorderBrush="{DynamicResource SelectionBorder}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Opacity="0.75"
                        Visibility="{Binding DropIntoVisibility}"
                        IsHitTestVisible="False" />
                <Border x:Name="ManagerStateStrip"
                        Width="3"
                        Margin="0,3,0,3"
                        HorizontalAlignment="Left"
                        Background="{Binding StatusStripBrush}"
                        CornerRadius="2"
                        Visibility="{Binding StatusStripVisibility}"
                        IsHitTestVisible="False" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ManagerSelectionDot"
                             Grid.Column="0"
                             Width="7"
                             Height="7"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Accent}"
                             Visibility="{Binding ManagerSelectionDotVisibility}"
                             IsHitTestVisible="False" />
                    <TextBlock Text="{Binding Icon}"
                               Grid.Column="1"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{Binding Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="{Binding Weight}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="🔒"
                                       Margin="8,0,0,0"
                                       ToolTip="{Binding LockToolTip}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding LockVisibility}" />
                            <Border Grid.Column="2"
                                    Background="{Binding ListeningBadgeBrush}"
                                    CornerRadius="9"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ListeningBadgeVisibility}">
                                <TextBlock Text="{Binding ListeningBadgeText}"
                                           Foreground="White"
                                           FontSize="10" />
                            </Border>
                            <TextBox x:Name="RenameTextBox"
                                     MinHeight="24"
                                     Margin="-4,-3,0,-2"
                                     Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ExplorerRenameTextBoxStyle}"
                                     Loaded="RenameTextBox_Loaded"
                                     KeyDown="RenameTextBox_KeyDown"
                                     LostFocus="RenameTextBox_LostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <Border Height="3"
                        Margin="-5,-7,-5,0"
                        Background="{DynamicResource Accent}"
                        CornerRadius="2"
                        VerticalAlignment="Top"
                        Visibility="{Binding DropBeforeVisibility}"
                        IsHitTestVisible="False" />
                <Border Height="3"
                        Margin="-5,0,-5,-7"
                        Background="{DynamicResource Accent}"
                        CornerRadius="2"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding DropAfterVisibility}"
                        IsHitTestVisible="False" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="ExplorerListItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Subtitle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="ItemRoot"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource SelectionBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                                <Setter TargetName="ItemRoot" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="ExplorerRowsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerTilesPanel">
            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ExplorerDetailsTemplate">
            <Grid MinHeight="34" Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="2*" MinWidth="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="125" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Accent}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ExplorerTitleTextStyle}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ExplorerRenameTextBoxStyle}"
                             Loaded="RenameTextBox_Loaded" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ExplorerTypeText}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding ExplorerTriggerText}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding ExplorerModifiedText}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExplorerListTemplate">
            <Grid Width="260" MinHeight="44" Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{Binding Accent}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="5,0,0,0">
                    <StackPanel x:Name="ListTitlePanel" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource ExplorerTitleTextStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ExplorerRenameTextBoxStyle}"
                             VerticalAlignment="Center" Loaded="RenameTextBox_Loaded" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExplorerSmallIconTemplate">
            <Grid Width="170" Height="38" Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="{Binding Accent}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ExplorerTitleTextStyle}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ExplorerRenameTextBoxStyle}"
                             VerticalAlignment="Center" Loaded="RenameTextBox_Loaded" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExplorerLargeIconTemplate">
            <Grid Width="112" Height="104" Margin="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="42" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ExplorerTitleTextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" />
                    <TextBox Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ExplorerRenameTextBoxStyle}"
                             VerticalAlignment="Top" Loaded="RenameTextBox_Loaded" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource SidebarPanelBorderStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid x:Name="DatabaseNavigationBar"
                      Margin="0,0,0,8"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToManagerButton"
                            Grid.Column="0"
                            MinWidth="90"
                            Content="返回管理"
                            Click="BackToManager_Click" />
                    <Button x:Name="UpFolderButton"
                            Grid.Column="2"
                            MinWidth="76"
                            Content="返回上级"
                            ToolTip="返回上级"
                            Click="UpFolder_Click" />
                    <TextBlock x:Name="CurrentDatabaseTitleText"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryText}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="DatabaseOnlyControls">
                    <Grid Margin="0,0,0,8">
                    <TextBox x:Name="MacroSearchBox"
                             Height="32"
                             TextChanged="MacroSearchBox_TextChanged" />
                    <TextBlock x:Name="MacroSearchPlaceholderText"
                               Text="搜索宏">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=MacroSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LibrarySortBox"
                                  Grid.Column="0"
                                  Height="30"
                                  SelectionChanged="LibrarySortBox_SelectionChanged">
                            <ComboBoxItem Tag="manual" Content="自定义顺序" IsSelected="True" />
                            <ComboBoxItem Tag="name" Content="按字母顺序" />
                            <ComboBoxItem Tag="updated" Content="最近更新" />
                        </ComboBox>
                        <ComboBox x:Name="LibraryViewBox"
                                  Grid.Column="2"
                                  Height="30"
                                  SelectionChanged="LibraryViewBox_SelectionChanged">
                            <ComboBoxItem Tag="details" Content="详细信息" IsSelected="True" />
                            <ComboBoxItem Tag="list" Content="列表" />
                            <ComboBoxItem Tag="smallIcons" Content="小图标" />
                            <ComboBoxItem Tag="largeIcons" Content="大图标" />
                        </ComboBox>
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="NewMacroMenuButton" MinWidth="88" Content="新建" Click="NewMacroMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="NewMacroContextMenu">
                                    <MenuItem x:Name="ToolbarNewMacroMenuItem" Header="宏文件" InputGestureText="Ctrl+N" Click="NewMacro_Click" />
                                    <MenuItem x:Name="ToolbarNewConditionMacroMenuItem" Header="条件宏" Click="NewConditionMacro_Click" />
                                    <MenuItem x:Name="ToolbarNewFolderMenuItem" Header="文件夹" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="ManagerOnlyControls">
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="NewGroupButton" MinWidth="96" Content="新建数据库" Click="NewGroup_Click" />
                        <Button x:Name="DeleteDatabaseButton" MinWidth="96" Content="删除数据库" Style="{StaticResource DangerButton}" Click="DeleteDatabase_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="GroupProcessFilterLabelText"
                               Text="启用进程"
                               Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,0">
                    <TextBox x:Name="GroupProcessFilterBox"
                             Height="30"
                             ToolTip="仅当前进程在最前面时启用该分组，例如 chrome.exe 或 notepad; chrome。" />
                    <TextBlock x:Name="GroupProcessFilterPlaceholderText"
                               Text="例如 chrome.exe">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=GroupProcessFilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                    <WrapPanel Margin="0,6,0,8">
                        <Button x:Name="SelectProcessButton"
                                MinWidth="76"
                                Content="进程"
                                Click="SelectProcess_Click" />
                        <Button x:Name="SelectProcessFileButton"
                                MinWidth="76"
                                Content="文件"
                                Click="SelectProcessFile_Click" />
                        <Button x:Name="ApplyGroupButton"
                                MinWidth="56"
                                Content="应用"
                                Click="ApplyGroup_Click" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" MinHeight="220" Margin="0,0,0,10">
                <TreeView x:Name="MacroTreeView"
                          ItemTemplate="{StaticResource MacroTreeNodeTemplate}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False"
                          SelectedItemChanged="MacroTreeView_SelectedItemChanged"
                          Loaded="MacroTreeView_Loaded"
                          Unloaded="MacroTreeView_Unloaded"
                          PreviewMouseMove="MacroTreeView_PreviewMouseMove"
                          PreviewMouseWheel="MacroTreeView_PreviewMouseWheel"
                          PreviewMouseRightButtonDown="MacroTreeView_PreviewMouseRightButtonDown"
                          DragOver="MacroTreeView_DragOver"
                          DragLeave="MacroTreeView_DragLeave"
                          KeyDown="MacroTreeView_KeyDown"
                          AllowDrop="True"
                          Drop="MacroTreeView_Drop">
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="MacroTreeContextMenu_Opened"
                                     Closed="MacroTreeContextMenu_Closed">
                            <MenuItem x:Name="RenameMenuItem" Header="重命名" InputGestureText="F2" Click="RenameMenuItem_Click" />
                            <MenuItem x:Name="InsertConditionMacroMenuItem" Header="插入到当前宏" Click="InsertConditionMacroMenuItem_Click" />
                            <MenuItem x:Name="EditConditionMacroMenuItem" Header="编辑条件宏" Click="EditConditionMacroMenuItem_Click" />
                            <MenuItem x:Name="CopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click" />
                            <MenuItem x:Name="PasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" Click="PasteMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteMenuItem" Header="删除" InputGestureText="Delete" Click="DeleteMenuItem_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <Grid x:Name="ExplorerView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ExplorerDetailsHeader" Margin="7,0,16,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" MinWidth="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="125" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" x:Name="ExplorerNameHeaderText" Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="2" x:Name="ExplorerTypeHeaderText" Text="类型" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="3" x:Name="ExplorerTriggerHeaderText" Text="触发键" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="4" x:Name="ExplorerModifiedHeaderText" Text="修改日期" Style="{StaticResource FieldLabel}" />
                    </Grid>
                    <ListView x:Name="ExplorerListView"
                              Grid.Row="1"
                              Background="{DynamicResource PanelBackground}"
                              Foreground="{DynamicResource PrimaryText}"
                              BorderBrush="{DynamicResource PanelBorder}"
                              BorderThickness="1"
                              FocusVisualStyle="{x:Null}"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource ExplorerListItemStyle}"
                              ItemTemplate="{StaticResource ExplorerDetailsTemplate}"
                              ItemsPanel="{StaticResource ExplorerRowsPanel}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.PanningMode="Both"
                              Loaded="ExplorerListView_Loaded"
                              PreviewMouseWheel="ExplorerListView_PreviewMouseWheel"
                              SelectionChanged="ExplorerListView_SelectionChanged"
                              MouseDoubleClick="ExplorerListView_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="ExplorerListView_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="ExplorerListView_PreviewMouseRightButtonDown"
                              PreviewMouseMove="ExplorerListView_PreviewMouseMove"
                              DragOver="ExplorerListView_DragOver"
                              Drop="ExplorerListView_Drop"
                              KeyDown="ExplorerListView_KeyDown"
                              AllowDrop="True">
                        <ListView.ContextMenu>
                            <ContextMenu Opened="ExplorerContextMenu_Opened" Closed="MacroTreeContextMenu_Closed">
                                <MenuItem x:Name="ExplorerExportMacroMenuItem" Header="导出" Click="ExportMacro_Click" />
                                <MenuItem x:Name="ExplorerInsertConditionMacroMenuItem" Header="插入到当前宏" Click="InsertConditionMacroMenuItem_Click" />
                                <MenuItem x:Name="ExplorerEditConditionMacroMenuItem" Header="编辑条件宏" Click="EditConditionMacroMenuItem_Click" />
                                <MenuItem x:Name="ExplorerExportFolderMenuItem" Header="导出该宏文件夹" Click="ExportFolderMenuItem_Click" />
                                <MenuItem x:Name="ExplorerNewMenuItem" Header="新建">
                                    <MenuItem x:Name="ExplorerNewMacroMenuItem" Header="宏文件" InputGestureText="Ctrl+N" Click="NewMacro_Click" />
                                    <MenuItem x:Name="ExplorerNewConditionMacroMenuItem" Header="条件宏" Click="NewConditionMacro_Click" />
                                    <MenuItem x:Name="ExplorerNewFolderMenuItem" Header="文件夹" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click" />
                                </MenuItem>
                                <Separator x:Name="ExplorerContextMenuPrimarySeparator" />
                                <MenuItem x:Name="ExplorerRenameMenuItem" Header="重命名" InputGestureText="F2" Click="RenameMenuItem_Click" />
                                <MenuItem x:Name="ExplorerCopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click" />
                                <MenuItem x:Name="ExplorerPasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" Click="PasteMenuItem_Click" />
                                <MenuItem x:Name="ExplorerToggleLockMenuItem" Header="锁定宏文件" Click="ExplorerToggleLockMenuItem_Click" />
                                <Separator x:Name="ExplorerContextMenuViewSeparator" />
                                <MenuItem x:Name="ExplorerViewMenuItem" Header="查看">
                                    <MenuItem x:Name="ExplorerDetailsMenuItem" Header="详细信息" Tag="details" IsCheckable="True" Click="ExplorerViewMenuItem_Click" />
                                    <MenuItem x:Name="ExplorerListMenuItem" Header="列表" Tag="list" IsCheckable="True" Click="ExplorerViewMenuItem_Click" />
                                    <MenuItem x:Name="ExplorerSmallIconsMenuItem" Header="小图标" Tag="smallIcons" IsCheckable="True" Click="ExplorerViewMenuItem_Click" />
                                    <MenuItem x:Name="ExplorerLargeIconsMenuItem" Header="大图标" Tag="largeIcons" IsCheckable="True" Click="ExplorerViewMenuItem_Click" />
                                </MenuItem>
                                <MenuItem x:Name="ExplorerSortMenuItem" Header="排序方式">
                                    <MenuItem x:Name="ExplorerSortManualMenuItem" Header="自定义顺序" Tag="manual" Click="ExplorerSortMenuItem_Click" />
                                    <MenuItem x:Name="ExplorerSortNameMenuItem" Header="名称" Tag="name" Click="ExplorerSortMenuItem_Click" />
                                    <MenuItem x:Name="ExplorerSortUpdatedMenuItem" Header="修改日期" Tag="updated" Click="ExplorerSortMenuItem_Click" />
                                </MenuItem>
                                <MenuItem x:Name="ExplorerRefreshMenuItem" Header="刷新" InputGestureText="F5" Click="ExplorerRefreshMenuItem_Click" />
                                <Separator x:Name="ExplorerContextMenuDeleteSeparator" />
                                <MenuItem x:Name="ExplorerDeleteMenuItem" Header="删除" InputGestureText="Delete" Click="DeleteMenuItem_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                    <TextBlock x:Name="ExplorerSelectionStatusText"
                               Grid.Row="2"
                               Margin="4,5,4,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="10" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="LibraryToolsScrollViewer"
                          Grid.Row="2"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                    <StackPanel x:Name="ManagerRuntimeControls">
                        <Border Height="1"
                                Margin="0,2,0,10"
                                Background="{DynamicResource PanelBorder}" />
                        <TextBlock x:Name="GlobalRuntimeTitleText"
                                   Text="全局运行"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="PrecisionModeLabelText"
                                   Text="精度模式"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PrecisionModeBox"
                                  Height="30"
                                  Margin="0,0,0,8"
                                  SelectionChanged="PrecisionModeBox_SelectionChanged">
                            <ComboBoxItem Tag="balanced" Content="基础" />
                            <ComboBoxItem Tag="extremeDuringPlayback" Content="高性能" IsSelected="True" />
                            <ComboBoxItem Tag="ultraLowJitter" Content="极限" />
                        </ComboBox>
                        <TextBlock x:Name="AffinityMaskLabelText"
                                   Text="极限核心掩码"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AffinityMaskBox"
                                 Height="30"
                                 TextChanged="RuntimePrecision_TextChanged"
                                 ToolTip="仅极限模式生效：限制极限模式播放线程和 Native 引擎使用指定 CPU 核心，减少线程迁移抖动；留空则自动选择。示例：0x1F。" />
                        <TextBlock x:Name="AffinityMaskHelpText"
                                   Text="仅极限模式生效：限制极限模式播放线程和 Native 引擎使用指定 CPU 核心，减少线程迁移抖动；留空则自动选择。示例：0x1F。"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10" />
                        <Border Height="1"
                                Margin="0,2,0,10"
                                Background="{DynamicResource PanelBorder}" />
                        <TextBlock x:Name="ListeningTitleText"
                                   Text="监听"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <Grid x:Name="ListenAllButtonsGrid" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartAllListeningButton"
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Content="请选择数据库"
                                    Click="StartAllListening_Click" />
                            <Button x:Name="StopAllListeningButton"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    Content="停止所选"
                                    Click="StopAllListening_Click" />
                        </Grid>
                        <Button x:Name="StopEveryListeningButton"
                                MinWidth="0"
                                Margin="0,0,0,10"
                                Content="全部停止"
                                Click="StopEveryListening_Click" />
                    </StackPanel>

                    <StackPanel x:Name="LibraryImportExportPanel">
                        <Border Height="1"
                                Margin="0,2,0,10"
                                Background="{DynamicResource PanelBorder}" />
                        <TextBlock x:Name="ImportExportTitleText"
                                   Text="导入 / 导出"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="ImportMacroButton" MinWidth="120" Content="导入宏" Click="ImportMacro_Click" />
                            <Button x:Name="ExportMacroButton"
                                    MinWidth="120"
                                    Margin="8,0,0,0"
                                    Content="导出"
                                    Click="ExportMacro_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ConversionText"
                                   Text="转换器已内置"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

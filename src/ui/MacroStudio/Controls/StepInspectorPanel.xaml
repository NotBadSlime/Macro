<UserControl x:Class="MacroStudio.Controls.StepInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MacroStudio.Controls">
    <StackPanel Margin="2,0">
        <TextBlock x:Name="EmptySelectionText"
                   Text="选择一个步骤后可视化编辑。"
                   Foreground="{DynamicResource SecondaryText}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
        <StackPanel x:Name="SelectedDetail" Visibility="Collapsed">
            <DockPanel Margin="0,2,0,12">
                <local:ActionGlyph x:Name="StepGlyph"
                                   Width="21" Height="21"
                                   Margin="0,0,8,0"
                                   DockPanel.Dock="Left" />
                <TextBlock x:Name="ActionHeading"
                           TextWrapping="Wrap"
                           FontSize="19"
                           FontWeight="SemiBold" />
            </DockPanel>
            <StackPanel x:Name="KeyParameterPreview"
                        Orientation="Horizontal"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                <TextBlock x:Name="KeyStateArrow"
                           Foreground="{DynamicResource Accent}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <Border Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,3">
                    <TextBlock x:Name="KeyPreviewText"
                               MaxWidth="152"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Cascadia Mono, Consolas" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="ParameterPreview"
                       Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <local:StepEditorPanel x:Name="Editor" />
            <TextBlock x:Name="EditStatusText"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Margin="0,0,0,7"
                       Visibility="Collapsed" />
            <WrapPanel>
                <Button x:Name="ApplyButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="应用" Margin="0,0,6,6"
                        Click="Apply_Click" />
                <Button x:Name="CopyButton"
                        Content="复制" Margin="0,0,6,6"
                        Click="Copy_Click" />
                <Button x:Name="RemoveButton"
                        Style="{StaticResource DangerButton}"
                        Content="删除" Margin="0,0,0,6"
                        Click="Remove_Click" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

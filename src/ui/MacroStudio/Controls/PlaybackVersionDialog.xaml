<Window x:Class="MacroStudio.Controls.PlaybackVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="播放版本"
        Width="640"
        Height="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel>
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Style="{StaticResource FieldHelpText}" Margin="2,2,0,12" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="NextRunNoteText" Style="{StaticResource FieldHelpText}" Margin="2,10,0,10" />
            <StackPanel Style="{StaticResource DialogButtonRow}">
                <Button x:Name="CancelButton" MinWidth="82" IsCancel="True" Content="取消" />
                <Button x:Name="ConfirmButton"
                        MinWidth="82"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Content="确定"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Release list: newest first, the current one marked. -->
            <ListBox x:Name="VersionList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ItemContainerStyle="{StaticResource VersionListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="PlaybackVersionList" />

            <!-- Selected release. -->
            <Border Grid.Column="2" Style="{StaticResource DialogCard}" Margin="0,0,0,6" Padding="16,14,16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="SelectedTitleText" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}" />
                            <Border x:Name="SelectedBadge" Style="{StaticResource SmallBadge}" Margin="10,2,0,0">
                                <TextBlock x:Name="SelectedBadgeText" FontSize="11" Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SelectedEngineText" Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                        <TextBlock x:Name="ChangesLabelText" Text="这一版改了什么" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="ChangeList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="5" Height="5" Margin="1,7,0,0" VerticalAlignment="Top"
                                                 Fill="{DynamicResource Accent}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="19"
                                                   Foreground="{DynamicResource PrimaryText}" FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="MissingNotice" Background="{DynamicResource DangerHover}" CornerRadius="8"
                                Padding="10,8" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="MissingNoticeText" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

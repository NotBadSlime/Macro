<UserControl x:Class="MacroStudio.Controls.SequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MacroStudio.Controls">
    <Grid x:Name="SequenceRoot" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="NameLabelText" Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MacroNameBox"
                                 Height="38"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 AutomationProperties.LabeledBy="{Binding ElementName=NameLabelText}"
                                 LostFocus="MacroNameBox_LostFocus"
                                 KeyDown="MacroNameBox_KeyDown" />
                        <TextBlock x:Name="LibraryPathLabelText"
                                   Text="宏路径"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                        <TextBox x:Name="LibraryPathBox"
                                 Height="30"
                                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                 FontSize="12"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LibraryPathLabelText}"
                                 ToolTip="数据库 > 文件夹 > 宏名。回车后宏数据库会跳到对应位置。"
                                 LostFocus="LibraryPathBox_LostFocus"
                                 KeyDown="LibraryPathBox_KeyDown" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource PanelRaised}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScheduledStepsLabelText" Text="计划步骤" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="StepCountText"
                                       Text="0"
                                       Foreground="{DynamicResource Accent}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="21"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DurationLabelText"
                                       Text="时长"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,7,0,0" />
                            <TextBlock x:Name="DurationText"
                                       Text="0 ms"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel x:Name="SequenceHeaderCommands" Margin="0,12,0,0">
                    <Button x:Name="RunNowHeaderButton"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="84"
                            Content="立即运行"
                            Margin="0,0,6,6"
                            Click="RunNow_Click" />
                    <Button x:Name="StopHeaderButton"
                            Style="{StaticResource DangerButton}"
                            MinWidth="56"
                            Content="停止"
                            Margin="0,0,6,6"
                            Click="Stop_Click" />
                    <Button x:Name="RecordInputButton"
                            MinWidth="92"
                            Content="● 开始录制"
                            ToolTip="记录键盘、鼠标和真实延迟；Ctrl+Shift+F12 停止"
                            Margin="0,0,6,6"
                            Click="RecordInputButton_Click" />
                    <Button x:Name="SaveLibraryButton"
                            MinWidth="78"
                            Content="保存到库"
                            Margin="0,0,6,6"
                            Click="SaveLibrary_Click" />
                    <ToggleButton x:Name="MacroLockButton"
                                  Style="{StaticResource ToolToggleButton}"
                                  MinWidth="78"
                                  Content="锁定编辑"
                                  ToolTip="锁定后仍可运行和导出，但不能修改宏"
                                  Margin="0,0,0,6"
                                  Click="MacroLockButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="RecordingStatusText"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Danger}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="Collapsed" />

                <Expander x:Name="DelayAdjustSection"
                          Header="批量延迟"
                          Padding="10,0,10,10">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock x:Name="DelayAdjustLabel"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Text="延迟增减" />
                                <TextBox x:Name="DelayAdjustBox"
                                         Width="64"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=DelayAdjustLabel}"
                                         ToolTip="正数加长全部延迟，负数缩短，但不会低于最低值。"
                                         Text="0"
                                         KeyDown="DelayAdjustBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock x:Name="DelayFloorLabel"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Text="最低" />
                                <TextBox x:Name="DelayFloorBox"
                                         Width="56"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=DelayFloorLabel}"
                                         ToolTip="减少时不会低于这个毫秒数。已经等于或低于它的延迟保持不动。"
                                         Text="0"
                                         KeyDown="DelayAdjustBox_KeyDown" />
                            </StackPanel>
                            <Button x:Name="DelayAdjustButton"
                                    Margin="0,0,0,6"
                                    Content="调整全部延迟"
                                    ToolTip="调整当前序列里的全部延迟卡片，包括循环和像素条件中的延迟。已经到达最低值的延迟，再减少时保持不动。可用撤回恢复。"
                                    Click="DelayAdjustButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="DelayAdjustStatusText"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="12">
            <local:StepSequencePanel x:Name="StepSequenceControl" />
        </Border>
    </Grid>
</UserControl>

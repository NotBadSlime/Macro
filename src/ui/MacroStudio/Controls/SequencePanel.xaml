<UserControl x:Class="MacroStudio.Controls.SequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MacroStudio.Controls">
    <UserControl.Resources>
        <Style x:Key="StudioRunButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1 0 L10 5 L1 10 Z" Fill="White"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="SequenceRoot" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource StudioPanelHeaderSurface}"
                BorderBrush="{DynamicResource StudioChromeEdge}" Margin="0,0,0,10" ClipToBounds="True">
            <Grid>
                <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource StudioHorizon}" IsHitTestVisible="False" />
                <Rectangle x:Name="RunningAccent" Height="2" VerticalAlignment="Top"
                           Fill="{DynamicResource StudioSignal}" IsHitTestVisible="False" Opacity="0" />
                <Canvas Width="246" HorizontalAlignment="Right" ClipToBounds="True" IsHitTestVisible="False">
                    <Path Data="M10 32 H111 L146 2 H246 M57 46 H143 L173 16 H246 M86 65 H152 L184 33 H246 M145 77 H168 L190 55 H246 M166 95 H179 L216 68 H246"
                          Stroke="{DynamicResource StudioSignal}" StrokeThickness="1" Opacity="0.25" />
                    <Path Data="M27 30 A2 2 0 1 1 27 34 A2 2 0 1 1 27 30 M58 44 A2 2 0 1 1 58 48 A2 2 0 1 1 58 44 M87 63 A2 2 0 1 1 87 67 A2 2 0 1 1 87 63"
                          Fill="{DynamicResource StudioSignal}" Opacity="0.42" />
                </Canvas>
                <StackPanel x:Name="EditorHeaderStack" Margin="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameLabelText" Text="名称" Visibility="Collapsed" />
                    <TextBox x:Name="MacroNameBox" Height="45" MinWidth="0"
                             Background="Transparent" BorderBrush="Transparent" Padding="4,0,5,0"
                             FontSize="28" FontWeight="Bold" Margin="0,0,10,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=NameLabelText}"
                             LostFocus="MacroNameBox_LostFocus" KeyDown="MacroNameBox_KeyDown" />
                    <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource StudioChromeEdge}" BorderThickness="1" CornerRadius="7" Padding="9,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StepActivityDot" Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="StepActivityText" Text="播放：空闲" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="LibraryPathLabelText" DockPanel.Dock="Left" Text="宏路径"
                               Foreground="{DynamicResource SecondaryText}" FontSize="11"
                               VerticalAlignment="Center" Margin="5,0,8,0" />
                    <TextBox x:Name="LibraryPathBox" Height="28" MinWidth="0"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11"
                             Foreground="{DynamicResource StudioSignal}" Background="{DynamicResource ControlBackground}"
                             BorderBrush="{DynamicResource StudioChromeEdge}"
                             AutomationProperties.LabeledBy="{Binding ElementName=LibraryPathLabelText}"
                             ToolTip="数据库 > 文件夹 > 宏名。回车后宏数据库会跳到对应位置。"
                             LostFocus="LibraryPathBox_LostFocus" KeyDown="LibraryPathBox_KeyDown" />
                </DockPanel>

                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource StudioChromeEdge}"
                        BorderThickness="1" CornerRadius="9" Padding="7,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SequenceOverviewLabel" Text="步骤概览" Margin="9,0,0,0"
                                       Foreground="{DynamicResource StudioSignal}" FontSize="11" FontWeight="SemiBold" />
                            <local:SequenceOverview x:Name="SequenceOverviewChart" Grid.Row="1" Height="49"
                                                    Foreground="{DynamicResource StudioSignal}" BorderBrush="{DynamicResource StudioChromeEdge}"
                                                    Focusable="True" Cursor="Hand"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=SequenceOverviewLabel}" />
                        </Grid>
                        <UniformGrid Grid.Column="1" Rows="1" Margin="3,0,2,0">
                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ScheduledStepsLabelText" Text="计划步骤" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="StepCountText" Text="0" Foreground="{DynamicResource StudioSignal}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DurationLabelText" Text="时长" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="DurationText" Text="0 ms" Foreground="{DynamicResource Accent}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Bold"
                                           MaxWidth="130" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <WrapPanel x:Name="SequenceHeaderCommands" Margin="0,9,0,0">
                    <Button x:Name="RunNowHeaderButton"
                            Style="{StaticResource StudioRunButton}"
                            MinWidth="84"
                            Content="立即运行"
                            Margin="0,0,6,6"
                            Click="RunNow_Click" />
                    <Button x:Name="StopHeaderButton"
                            Style="{StaticResource DangerButton}"
                            MinWidth="56"
                            Content="停止"
                            Margin="0,0,6,6"
                            Click="Stop_Click" />
                    <Button x:Name="RecordInputButton"
                            MinWidth="92"
                            Content="● 开始录制"
                            ToolTip="记录键盘、鼠标和真实延迟；Ctrl+Shift+F12 停止"
                            Margin="0,0,6,6"
                            Click="RecordInputButton_Click" />
                    <Button x:Name="SaveLibraryButton"
                            MinWidth="78"
                            Content="保存到库"
                            Margin="0,0,6,6"
                            Click="SaveLibrary_Click" />
                    <ToggleButton x:Name="MacroLockButton"
                                  Style="{StaticResource ToolToggleButton}"
                                  MinWidth="78"
                                  Content="锁定编辑"
                                  ToolTip="锁定后仍可运行和导出，但不能修改宏"
                                  Margin="0,0,0,6"
                                  Click="MacroLockButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="RecordingStatusText"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Danger}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="Collapsed" />

                <Expander x:Name="DelayAdjustSection"
                          Header="批量延迟"
                          Padding="10,0,10,10">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock x:Name="DelayAdjustLabel"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Text="延迟增减" />
                                <TextBox x:Name="DelayAdjustBox"
                                         Width="64"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=DelayAdjustLabel}"
                                         ToolTip="正数加长全部延迟，负数缩短，但不会低于最低值。"
                                         Text="0"
                                         KeyDown="DelayAdjustBox_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock x:Name="DelayFloorLabel"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Text="最低" />
                                <TextBox x:Name="DelayFloorBox"
                                         Width="56"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=DelayFloorLabel}"
                                         ToolTip="减少时不会低于这个毫秒数。已经等于或低于它的延迟保持不动。"
                                         Text="0"
                                         KeyDown="DelayAdjustBox_KeyDown" />
                            </StackPanel>
                            <Button x:Name="DelayAdjustButton"
                                    Margin="0,0,0,6"
                                    Content="调整全部延迟"
                                    ToolTip="调整当前序列里的全部延迟卡片，包括循环和像素条件中的延迟。已经到达最低值的延迟，再减少时保持不动。可用撤回恢复。"
                                    Click="DelayAdjustButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="DelayAdjustStatusText"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </Expander>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="12">
            <local:StepSequencePanel x:Name="StepSequenceControl" />
        </Border>
    </Grid>
</UserControl>

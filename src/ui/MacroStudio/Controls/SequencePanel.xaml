<UserControl x:Class="MacroStudio.Controls.SequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MacroStudio.Controls">
    <Grid x:Name="SequenceRoot" ClipToBounds="True" Margin="24,12,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="EditorHeaderStack" Margin="0,0,0,10">
            <TextBlock x:Name="LibraryPathLabelText" Text="宏路径" Visibility="Collapsed" />
            <TextBox x:Name="LibraryPathBox" Height="25" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                     Padding="2,0,4,0" Foreground="{DynamicResource SecondaryText}" FontSize="12"
                     AutomationProperties.LabeledBy="{Binding ElementName=LibraryPathLabelText}"
                     ToolTip="数据库 > 文件夹 > 宏名。回车后宏数据库会跳到对应位置。"
                     LostFocus="LibraryPathBox_LostFocus" KeyDown="LibraryPathBox_KeyDown" />
            <TextBlock x:Name="NameLabelText" Text="名称" Visibility="Collapsed" />
            <TextBox x:Name="MacroNameBox" Height="51" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                     Padding="1,0,4,0" FontSize="34" FontWeight="Bold"
                     AutomationProperties.LabeledBy="{Binding ElementName=NameLabelText}"
                     LostFocus="MacroNameBox_LostFocus" KeyDown="MacroNameBox_KeyDown" />
            <TextBlock x:Name="StandaloneConditionLabel" Text="条件宏" Visibility="Collapsed"
                       Margin="3,3,0,0" Foreground="{DynamicResource StudioSignal}" FontSize="12" FontWeight="SemiBold" />
            <StackPanel x:Name="SequenceStats" Orientation="Horizontal" Margin="3,3,0,0">
                <TextBlock x:Name="StepCountText" Text="0" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                <TextBlock x:Name="ScheduledStepsLabelText" Text="计划步骤" Foreground="{DynamicResource SecondaryText}"
                           FontSize="12" Margin="5,0,0,0" />
                <Border Background="{DynamicResource PanelBorder}" Width="1" Height="12" Margin="12,0" />
                <TextBlock x:Name="DurationLabelText" Text="时长" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                <TextBlock x:Name="DurationText" Text="0 ms" FontFamily="Cascadia Mono, Consolas"
                           FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
            </StackPanel>
            <Border x:Name="EditorTabs" Margin="0,9,0,0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource PanelBorder}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="MainSequenceTab" MinWidth="94" Margin="0,0,4,3"
                                  Content="主序列" IsChecked="True" Style="{StaticResource RightToolTabStyle}"
                                  AutomationProperties.AutomationId="MainSequenceTab" Click="EditorTab_Click" />
                    <ToggleButton x:Name="ConditionsTab" MinWidth="94" Margin="0,0,0,3"
                                  Content="条件" Style="{StaticResource RightToolTabStyle}"
                                  AutomationProperties.AutomationId="ConditionsTab" Click="EditorTab_Click" />
                </StackPanel>
            </Border>
            <WrapPanel x:Name="SequenceHeaderCommands" Margin="0,12,0,0">
                <Button x:Name="RunNowHeaderButton"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="84"
                        Content="立即运行"
                        Margin="0,0,6,6"
                        Click="RunNow_Click" />
                <Button x:Name="StartupGateButton" MaxWidth="244" Padding="8,0" Margin="0,0,6,6"
                        Style="{StaticResource CommandBarButton}" Foreground="{DynamicResource StudioSignal}"
                        Background="{DynamicResource Selection}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                        Visibility="Collapsed" AutomationProperties.AutomationId="StartupGateButton"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding Text, ElementName=StartupGateHeaderText}"
                        AutomationProperties.LiveSetting="Polite" Click="StartupGateButton_Click">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StartupGateHeaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Button x:Name="AddStepActionButton" MinWidth="82" Padding="7,0" Content="＋ 添加动作"
                        Margin="0,0,6,6" Click="AddStepAction_Click" />
                <Button x:Name="StopHeaderButton"
                        Style="{StaticResource DangerButton}"
                        MinWidth="56"
                        Content="停止"
                        Margin="0,0,6,6"
                        Click="Stop_Click" />
                <Button x:Name="RecordInputButton"
                        MinWidth="92"
                        Content="● 开始录制"
                        ToolTip="记录键盘、鼠标和真实延迟；Ctrl+Shift+F12 停止"
                        Margin="0,0,6,6"
                        Click="RecordInputButton_Click" />
                <Button x:Name="SaveLibraryButton"
                        MinWidth="78"
                        Content="保存到库"
                        Margin="0,0,6,6"
                        Click="SaveLibrary_Click" />
                <ToggleButton x:Name="MacroLockButton"
                              Style="{StaticResource ToolToggleButton}"
                              MinWidth="78"
                              Content="锁定编辑"
                              ToolTip="锁定后仍可运行和导出，但不能修改宏"
                              Margin="0,0,0,6"
                              Click="MacroLockButton_Click" />
            </WrapPanel>
            <TextBlock x:Name="RecordingStatusText"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource Danger}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="Collapsed" />

            <Expander x:Name="DelayAdjustSection"
                      Header="批量延迟"
                      Padding="10,0,10,10">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock x:Name="DelayAdjustLabel"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Text="延迟增减" />
                            <TextBox x:Name="DelayAdjustBox"
                                     Width="64"
                                     Height="34"
                                     Margin="8,0,0,0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.LabeledBy="{Binding ElementName=DelayAdjustLabel}"
                                     ToolTip="正数加长全部延迟，负数缩短，但不会低于最低值。"
                                     Text="0"
                                     KeyDown="DelayAdjustBox_KeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                            <TextBlock x:Name="DelayFloorLabel"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Text="最低" />
                            <TextBox x:Name="DelayFloorBox"
                                     Width="56"
                                     Height="34"
                                     Margin="8,0,0,0"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.LabeledBy="{Binding ElementName=DelayFloorLabel}"
                                     ToolTip="减少时不会低于这个毫秒数。已经等于或低于它的延迟保持不动。"
                                     Text="0"
                                     KeyDown="DelayAdjustBox_KeyDown" />
                        </StackPanel>
                        <Button x:Name="DelayAdjustButton"
                                Margin="0,0,0,6"
                                Content="调整全部延迟"
                                ToolTip="调整当前序列里的全部延迟卡片，包括循环和像素条件中的延迟。已经到达最低值的延迟，再减少时保持不动。可用撤回恢复。"
                                Click="DelayAdjustButton_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="DelayAdjustStatusText"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <Border x:Name="MainStepsHost" Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
            <local:StepSequencePanel x:Name="StepSequenceControl" />
        </Border>
        <ContentControl x:Name="ConditionEditorHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>

<Window x:Class="MacroStudio.Controls.PrecisionControlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="精度控制"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PrecisionModeLabelText"
                   Text="精度模式"
                   Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="PrecisionModeBox" Height="30" Margin="0,0,0,10">
            <ComboBoxItem Tag="balanced" Content="低占用" />
            <ComboBoxItem Tag="extremeDuringPlayback" Content="均衡（推荐）" />
            <ComboBoxItem Tag="ultraLowJitter" Content="极限" />
        </ComboBox>

        <TextBlock x:Name="ProfileDescription" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="仅影响下一次运行；响应数值为预热后 1–2 个并发宏的待验证目标。条件轮询间隔保持原配置。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SecondaryText}" />
        <TextBlock x:Name="AffinityMaskLabelText"
                   Text="极限核心掩码"
                   Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AffinityMaskBox" Height="30" />
        <TextBlock x:Name="AffinityMaskHelpText"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryText}"
                   Margin="0,4,0,10" />
        <Button x:Name="ChooseCoresButton"
                HorizontalAlignment="Left"
                MinWidth="96"
                Height="30"
                Margin="0,0,0,16"
                Content="选择核心"
                Click="ChooseCoresButton_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" MinWidth="82" IsCancel="True" Content="取消" />
            <Button x:Name="ConfirmButton"
                    MinWidth="82"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Content="确定"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>

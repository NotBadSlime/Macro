<Window x:Class="MacroStudio.Controls.ActionAppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动作颜色"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <Border Margin="12"
            Padding="18"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="ActionTypeLabel" Text="动作类别" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ActionTypeBox"
                          Margin="0,6,0,0"
                          DisplayMemberPath="Name"
                          SelectionChanged="ActionTypeBox_SelectionChanged" />
            </StackPanel>

            <Button x:Name="TextColorButton"
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Click="TextColorButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextColorLabel" Text="文字颜色" VerticalAlignment="Center" />
                    <Border x:Name="TextColorSwatch" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" />
                    <TextBlock x:Name="TextColorHex" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button x:Name="IconColorButton"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Click="IconColorButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconColorLabel" Text="图标颜色" VerticalAlignment="Center" />
                    <Border x:Name="IconColorSwatch" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" />
                    <TextBlock x:Name="IconColorHex" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button x:Name="BackgroundColorButton"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Click="BackgroundColorButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackgroundColorLabel" Text="底色" VerticalAlignment="Center" />
                    <Border x:Name="BackgroundColorSwatch" Grid.Column="1" Width="22" Height="22" CornerRadius="4" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" />
                    <TextBlock x:Name="BackgroundColorHex" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border x:Name="PreviewCard"
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewIconBadge" Width="28" Height="28" CornerRadius="6" HorizontalAlignment="Left">
                        <TextBlock x:Name="PreviewIcon" Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="PreviewText" Grid.Column="1" Text="动作预览" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <DockPanel Grid.Row="5" Margin="0,18,0,0" LastChildFill="False">
                <Button x:Name="ResetButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ToolButton}"
                        MinWidth="100"
                        Click="ResetButton_Click"
                        Content="恢复默认" />
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="82"
                        IsDefault="True"
                        Click="CloseButton_Click"
                        Content="完成" />
            </DockPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="MacroStudio.Controls.ExportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出"
        Width="460"
        SizeToContent="Height"
        MinHeight="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <Border Margin="12"
            Padding="18"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="FormatPanel">
                <TextBlock x:Name="FormatStepLabel"
                           Text="导出格式"
                           Style="{StaticResource FieldLabel}" />
                <ListBox x:Name="FormatList"
                         Margin="0,8,0,0"
                         MinHeight="140"
                         MaxHeight="220"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="FormatList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,4" Style="{StaticResource SoftListItemBorder}">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="WeakFormatWarningText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="PackagingPanel"
                        Grid.Row="1"
                        Visibility="Collapsed">
                <TextBlock x:Name="PackagingStepLabel"
                           Text="打包方式"
                           Style="{StaticResource FieldLabel}" />
                <RadioButton x:Name="TwoFoldersRadio"
                             Margin="0,10,0,0"
                             GroupName="ExportPackaging"
                             IsChecked="True"
                             Content="两个子文件夹" />
                <RadioButton x:Name="ZipRadio"
                             Margin="0,8,0,0"
                             GroupName="ExportPackaging"
                             Content="ZIP 压缩包" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource ToolButton}"
                        MinWidth="82"
                        IsCancel="True"
                        Content="取消" />
                <Button x:Name="PrimaryButton"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Content="导出"
                        Click="PrimaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

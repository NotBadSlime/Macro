<Window x:Class="MacroStudio.Controls.ConditionMacroPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择条件宏"
        Width="520"
        Height="440"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <TextBox x:Name="FilterBox"
                     Height="30"
                     ToolTip="筛选条件宏名称或文件夹"
                     TextChanged="FilterBox_TextChanged" />
            <TextBlock x:Name="FilterPlaceholderText"
                       Text="筛选条件宏名称或文件夹">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="6">
            <Grid>
                <ListBox x:Name="MacroList"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="MacroList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,4" Style="{StaticResource SoftListItemBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFF9500"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LocationText}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText"
                           Text="当前宏数据库中没有条件宏"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    MinWidth="82"
                    IsCancel="True"
                    Content="取消" />
            <Button x:Name="SelectButton"
                    MinWidth="82"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Content="插入"
                    Click="SelectButton_Click" />
        </StackPanel>
    </Grid>
</Window>

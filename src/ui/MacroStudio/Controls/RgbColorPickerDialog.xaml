<Window x:Class="MacroStudio.Controls.RgbColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="390"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ColorPreview"
                    Height="54"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    CornerRadius="6" />

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" />
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" />
                <TextBlock x:Name="RedValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center" />
                <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" />
                <TextBlock x:Name="GreenValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center" />
                <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" />
                <TextBlock x:Name="BlueValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HexLabel" Text="HEX" VerticalAlignment="Center" />
                <TextBox x:Name="HexValueBox"
                         Grid.Column="1"
                         MaxLength="7"
                         LostKeyboardFocus="HexValueBox_LostKeyboardFocus"
                         KeyDown="HexValueBox_KeyDown" />
            </Grid>

            <StackPanel Grid.Row="5" Style="{StaticResource DialogButtonRow}">
                <Button x:Name="CancelButton"
                        Style="{StaticResource ToolButton}"
                        MinWidth="82"
                        IsCancel="True"
                        Content="取消" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="82"
                        IsDefault="True"
                        Click="ConfirmButton_Click"
                        Content="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

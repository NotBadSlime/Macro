<UserControl x:Class="MacroStudio.Controls.ActionPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:MacroStudio.Controls"
             Tag="{StaticResource ActionPaletteDragAdornerStyle}"
             SizeChanged="ActionPalette_SizeChanged">
    <StackPanel Margin="2,0">
        <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <Button x:Name="ActionColorSettingsButton"
                    DockPanel.Dock="Right"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Content="&#xE790;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource SequenceToolbarIconButton}"
                    ToolTip="动作颜色"
                    Click="ActionColorSettingsButton_Click" />
            <TextBlock x:Name="AddTitleText"
                       Text="添加"
                       Style="{StaticResource PanelTitle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <controls:CollapsibleSection x:Name="BasicActionsSection" Header="基础功能" IsExpanded="True">
        <primitives:UniformGrid x:Name="BasicCommandGrid" Columns="1">
            <Button x:Name="AddDelayButton"
                    Tag="Delay"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddDelayText" Text="延迟" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddDelayHintText" Text="固定或随机等待" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddKeyboardButton"
                    Tag="Keyboard"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE765;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddKeyboardText" Text="键盘功能" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddKeyboardHintText" Text="按下、抬起或输入" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMouseButton"
                    Tag="MouseButton"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE962;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMouseText" Text="鼠标按键" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddMouseHintText" Text="点击、按住与坐标" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMouseMoveButton"
                    Tag="MouseMove"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE8AB;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMouseMoveText" Text="鼠标移动" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddMouseMoveHintText" Text="相对或绝对移动" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddWheelButton"
                    Tag="MouseWheel"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWheelText" Text="滚轮" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddWheelHintText" Text="垂直/水平滚动" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddTextButton"
                    Tag="Text"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE8D2;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddTextActionText" Text="文本功能" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddTextHintText" Text="发送 Unicode 文本" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddCommentButton"
                    Tag="Comment"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#E8EAED">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddCommentText" Text="注释" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddCommentHintText" Text="只作标记，不执行任何动作" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMacroButton"
                    Tag="Macro"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF8EF">
                        <TextBlock Text="&#xE74C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMacroText" Text="宏" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddMacroActionHintText" Text="调用宏数据库条目" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </primitives:UniformGrid>
        </controls:CollapsibleSection>

        <controls:CollapsibleSection x:Name="AdvancedActionsSection" Header="高级功能" IsExpanded="True">
        <primitives:UniformGrid x:Name="AdvancedCommandGrid" Columns="1">
            <Button x:Name="AddWindowActivateButton"
                    Tag="WindowActivate"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF8EF">
                        <TextBlock Text="&#xE737;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWindowActivateText" Text="指定窗口到前台" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddWindowActivateHintText" Text="定位、恢复并确认目标窗口" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddOcrExtractTextButton"
                    Tag="OcrExtractText"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE8D2;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddOcrExtractTextText" Text="OCR 获取文本" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddOcrExtractTextHintText" Text="从混合文字中提取内容到剪贴板" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddOcrClickButton"
                    Tag="OcrClick"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#F8EAF5">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentPink}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddOcrClickText" Text="OCR 文字点击" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddOcrClickHintText" Text="识别区域内的文字并点击" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddPixelButton"
                    Tag="Pixel"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FDE8EF">
                        <TextBlock Text="&#xE81E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentPink}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddPixelText" Text="像素条件" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddPixelHintText" Text="匹配屏幕上的一个像素" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddTextWhenButton"
                    Tag="TextWhen"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE8D2;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddTextWhenText" Text="文字条件" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddTextWhenHintText" Text="识别到文字后再执行后续动作" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimitStartButton"
                    Tag="NetLimitStart"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE774;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimitStartText" Text="开启弱网" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddNetLimitStartHintText" Text="内置限速，不用另外安装。默认 695 B/s，可在卡片里改" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimitStopButton"
                    Tag="NetLimitStop"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#EAF3FF">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimitStopText" Text="关闭弱网" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddNetLimitStopHintText" Text="取消限速，恢复原来的网速" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimiterStartButton"
                    Tag="NetLimiterStart"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#E7F6F8">
                        <TextBlock Text="&#xEC4A;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimiterStartText" Text="NetLimiter 限速" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddNetLimiterStartHintText" Text="使用本机已安装的 NetLimiter，默认 695 B/s，可改" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimiterStopButton"
                    Tag="NetLimiterStop"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#E7F6F8">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBlue}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimiterStopText" Text="关闭 NetLimiter" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddNetLimiterStopHintText" Text="取消 NetLimiter 里的限速。没安装时不会生效" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddWeakNetStartButton"
                    Tag="WeakNetStart"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE839;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWeakNetStartText" Text="开启断网" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddWeakNetStartHintText" Text="丢弃外网数据包，拨快时间在卡片里设置" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddWeakNetStopButton"
                    Tag="WeakNetStop"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWeakNetStopText" Text="关闭断网" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddWeakNetStopHintText" Text="恢复网络。系统时间在宏结束时改回" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddClockShiftButton"
                    Tag="ClockShift"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddClockShiftText" Text="切换系统时间" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddClockShiftHintText" Text="把系统时间拨快，时长在卡片里设置" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddClockRestoreButton"
                    Tag="ClockRestore"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE777;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddClockRestoreText" Text="恢复系统时间" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddClockRestoreHintText" Text="立刻把系统时间改回。播放结束也会改回" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddFrameLockStartButton"
                    Tag="FrameLockStart"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#DDECE2">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddFrameLockStartText" Text="开启锁帧" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddFrameLockStartHintText" Text="把指定程序限到设定帧数" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddFrameLockStopButton"
                    Tag="FrameLockStop"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#DDECE2">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddFrameLockStopText" Text="关闭锁帧" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddFrameLockStopHintText" Text="恢复这个程序原来的帧数上限" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddParallelButton"
                    Tag="Parallel"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFEDEE">
                        <TextBlock Text="&#xE8C8;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Danger}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddParallelText" Text="并行" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddParallelHintText" Text="两条分支同时检测，都完成后再继续" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

        </primitives:UniformGrid>
        </controls:CollapsibleSection>

        <controls:CollapsibleSection x:Name="LoopActionsSection" Header="循环控制" IsExpanded="True">
        <primitives:UniformGrid x:Name="LoopCommandGrid" Columns="1">
            <Button x:Name="AddLoopButton"
                    Tag="Loop"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFEDEE">
                        <TextBlock Text="&#xE8EE;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Danger}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddLoopText" Text="循环" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddLoopHintText" Text="重复一组步骤" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddStopCurrentButton"
                    Tag="StopCurrent"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF4E0">
                        <TextBlock Text="&#xE71A;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddStopCurrentText" Text="停止本层宏动作" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddStopCurrentHintText" Text="退出当前调用，外层继续" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddStopIterationButton"
                    Tag="StopIteration"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFF0E5">
                        <TextBlock Text="&#xE71A;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddStopIterationText" Text="停止本轮播放" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddStopIterationHintText" Text="跳过本轮剩余步骤，循环继续" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddStopAllButton"
                    Tag="StopAll"
                    Style="{StaticResource ActionPaletteCommandStyle}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}" Background="#FFEDEE">
                        <TextBlock Text="&#xE71A;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   Foreground="{DynamicResource Danger}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddStopAllText" Text="停止本次播放" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddStopAllHintText" Text="立即终止整次宏播放" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </primitives:UniformGrid>
        </controls:CollapsibleSection>

        <TextBlock x:Name="DragHint"
                   Foreground="{DynamicResource SecondaryText}"
                   TextWrapping="Wrap"
                   Margin="2,6,2,0"
                   Text="点击添加，或拖到序列的目标位置。" />
        <TextBlock x:Name="AddMacroHintText"
                   Foreground="{DynamicResource SecondaryText}"
                   TextWrapping="Wrap"
                   Margin="2,3,2,0"
                   Text="把左侧宏拖到序列里，可以复制它的步骤。" />
    </StackPanel>
</UserControl>

<UserControl x:Class="MacroStudio.Controls.ActionPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:MacroStudio.Controls"
             Tag="{StaticResource ActionPaletteDragAdornerStyle}"
             SizeChanged="ActionPalette_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="StudioActionTile" TargetType="Button" BasedOn="{StaticResource ActionPaletteCommandStyle}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="3,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent"
                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" Opacity="0.16"
                                        IsHitTestVisible="False" />
                                <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="+" FontSize="15"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioActionSection" TargetType="controls:CollapsibleSection">
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:CollapsibleSection">
                        <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button x:Name="PART_ToggleButton"
                                        DockPanel.Dock="Top"
                                        Content="{TemplateBinding Header}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Margin="0"
                                        Padding="3,0,4,0"
                                        Height="29"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SectionHeader"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <DockPanel LastChildFill="True">
                                                    <Path x:Name="SectionArrow"
                                                          DockPanel.Dock="Right"
                                                          Data="M 0 0 L 5 5 L 10 0"
                                                          Stroke="{DynamicResource SecondaryText}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,2,0"
                                                          RenderTransformOrigin="0.5,0.5" />
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextBlock.Foreground="{DynamicResource PrimaryText}"
                                                                      TextBlock.FontWeight="SemiBold" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:CollapsibleSection}}" Value="True">
                                                    <Setter TargetName="SectionArrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SectionHeader" Property="Background" Value="{DynamicResource Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="SectionHeader" Property="Background" Value="{DynamicResource Selection}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="PART_ContentHost" Padding="0">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="2,0">
        <TextBlock x:Name="AddTitleText" Text="添加" Visibility="Collapsed" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ActionSearchBox"
                     AutomationProperties.AutomationId="ActionSearchBox"
                     AutomationProperties.Name="{Binding Text, ElementName=ActionSearchPlaceholder}"
                     Padding="34,0,10,0"
                     Height="32"
                     TextChanged="ActionSearchBox_TextChanged"
                     PreviewKeyDown="ActionSearchBox_PreviewKeyDown" />
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       IsHitTestVisible="False" />
            <TextBlock x:Name="ActionSearchPlaceholder" Text="搜索动作">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Margin" Value="34,0,6,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=ActionSearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ClearActionSearchButton"
                    Grid.Column="1"
                    Style="{StaticResource SequenceToolbarIconButton}"
                    Content="&#xE711;"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="清空动作搜索"
                    Visibility="Collapsed"
                    Click="ClearActionSearch_Click" />
            <Button x:Name="ActionColorSettingsButton"
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Margin="5,0,0,0"
                    Content="&#xE790;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource SequenceToolbarIconButton}"
                    ToolTip="动作颜色"
                    Click="ActionColorSettingsButton_Click" />
        </Grid>
        <TextBlock x:Name="ActionSearchEmptyText"
                   Text="没有找到匹配的动作。"
                   Foreground="{DynamicResource SecondaryText}"
                   TextWrapping="Wrap"
                   Margin="4,8,4,16"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="Collapsed" />

        <controls:CollapsibleSection x:Name="BasicActionsSection" Style="{StaticResource StudioActionSection}" Foreground="{DynamicResource AccentBlue}" Header="基础功能" IsExpanded="True">
        <primitives:UniformGrid x:Name="BasicCommandGrid" Columns="1">
            <Button x:Name="AddDelayButton"
                    Tag="Delay"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddDelayHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Delay}"
                                              Foreground="{DynamicResource SecondaryText}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddDelayText" Text="延迟" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddDelayHintText" Text="固定或随机等待" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddKeyboardButton"
                    Tag="Keyboard"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddKeyboardHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Keyboard}"
                                              Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddKeyboardText" Text="键盘功能" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddKeyboardHintText" Text="按下、抬起或输入" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMouseButton"
                    Tag="MouseButton"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddMouseHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.MouseButton}"
                                              Foreground="{DynamicResource AccentOrange}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMouseText" Text="鼠标按键" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddMouseHintText" Text="点击、按住与坐标" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMouseMoveButton"
                    Tag="MouseMove"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddMouseMoveHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.MouseMove}"
                                              Foreground="{DynamicResource AccentOrange}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMouseMoveText" Text="鼠标移动" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddMouseMoveHintText" Text="相对或绝对移动" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddWheelButton"
                    Tag="MouseWheel"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddWheelHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.MouseWheel}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWheelText" Text="滚轮" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddWheelHintText" Text="垂直/水平滚动" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddTextButton"
                    Tag="Text"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddTextHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Text}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddTextActionText" Text="文本功能" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddTextHintText" Text="发送 Unicode 文本" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddCommentButton"
                    Tag="Comment"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddCommentHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Comment}"
                                              Foreground="{DynamicResource SecondaryText}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddCommentText" Text="注释" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddCommentHintText" Text="只作标记，不执行任何动作" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddMacroButton"
                    Tag="Macro"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddMacroActionHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.MacroCall}"
                                              Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddMacroText" Text="宏" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddMacroActionHintText" Text="调用宏数据库条目" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </primitives:UniformGrid>
        </controls:CollapsibleSection>

        <controls:CollapsibleSection x:Name="AdvancedActionsSection" Style="{StaticResource StudioActionSection}" Foreground="{DynamicResource Accent}" Header="高级功能" IsExpanded="True">
        <primitives:UniformGrid x:Name="AdvancedCommandGrid" Columns="1">
            <Button x:Name="AddWindowActivateButton"
                    Tag="WindowActivate"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddWindowActivateHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Window}"
                                              Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddWindowActivateText" Text="指定窗口到前台" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddWindowActivateHintText" Text="定位、恢复并确认目标窗口" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddOcrExtractTextButton"
                    Tag="OcrExtractText"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddOcrExtractTextHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.OcrText}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddOcrExtractTextText" Text="OCR 获取文本" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddOcrExtractTextHintText" Text="从混合文字中提取内容到剪贴板" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddOcrClickButton"
                    Tag="OcrClick"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddOcrClickHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.OcrClick}"
                                              Foreground="{DynamicResource AccentPink}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddOcrClickText" Text="OCR 文字点击" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddOcrClickHintText" Text="识别区域内的文字并点击" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddPixelButton"
                    Tag="Pixel"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddPixelHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.Pixel}"
                                              Foreground="{DynamicResource AccentPink}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddPixelText" Text="像素条件" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddPixelHintText" Text="匹配屏幕上的一个像素" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddTextWhenButton"
                    Tag="TextWhen"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddTextWhenHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.TextWhen}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddTextWhenText" Text="文字条件" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddTextWhenHintText" Text="识别到文字后再执行后续动作" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimitStartButton"
                    Tag="NetLimitStart"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddNetLimitStartHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.NetworkRate}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimitStartText" Text="开启弱网" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddNetLimitStartHintText" Text="内置限速，不用另外安装。默认 695 B/s，可在卡片里改" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimitStopButton"
                    Tag="NetLimitStop"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddNetLimitStopHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.NetworkRateOff}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimitStopText" Text="关闭弱网" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddNetLimitStopHintText" Text="取消限速，恢复原来的网速" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimiterStartButton"
                    Tag="NetLimiterStart"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddNetLimiterStartHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"
                                              Data="{x:Static controls:ActionIcons.NetworkRate}"
                                              Foreground="{DynamicResource AccentBlue}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AddNetLimiterStartText" Text="NetLimiter 限速" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AddNetLimiterStartHintText" Text="使用本机已安装的 NetLimiter，默认 695 B/s，可改" Style="{StaticResource ActionPaletteDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="AddNetLimiterStopButton"
                    Tag="NetLimiterStop"
                    Style="{StaticResource StudioActionTile}"
                    ToolTip="{Binding Text, ElementName=AddNetLimiterStopHintText}"
                    Click="ActionPalette_Click"
                    PreviewMouseLeftButtonDown="ActionPalette_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ActionPalette_PreviewMouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ActionPaletteIconBadgeStyle}">
                        <controls:ActionGlyph Width="17" Height="17"

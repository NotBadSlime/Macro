<UserControl x:Class="MacroStudio.Controls.StepEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}" Padding="14">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock x:Name="StepEditorTitleText" Text="属性" Style="{StaticResource PanelTitle}" />
                <Button x:Name="ApplyStepEditButton"
                        DockPanel.Dock="Right"
                        MinWidth="72"
                        Content="应用"
                        Click="ApplyStepEdit_Click" />
            </DockPanel>
            <TextBlock x:Name="StepEditorHintText"
                       Text="选择一个步骤后可视化编辑。"
                       Foreground="{DynamicResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <StackPanel x:Name="StepEditorFieldsPanel">
                <StackPanel x:Name="MacroEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="MacroTargetLabelText" Text="宏" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MacroTargetBox" Height="30" IsEditable="True" />
                </StackPanel>

                <StackPanel x:Name="KeyboardEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="KeyLabelText" Text="键位" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button x:Name="CaptureStepKeyButton" DockPanel.Dock="Right" Width="78" Content="捕获" Click="CaptureStepKey_Click" />
                        <TextBox x:Name="StepKeyBox" Height="30" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="ButtonEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="ActionKindLabelText" Text="动作" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ActionKindBox" Height="30" IsEditable="True" />
                </StackPanel>

                <StackPanel x:Name="MouseButtonEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="MouseButtonLabelText" Text="鼠标按键" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MouseButtonBox" Height="30" IsEditable="True" />
                    <CheckBox x:Name="MouseButtonCoordinateEnabledBox"
                              Content="指定坐标"
                              Foreground="{DynamicResource PrimaryText}"
                              Margin="0,8,0,0" />
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=MouseButtonCoordinateEnabledBox}">
                        <ComboBox x:Name="MouseButtonCoordinateModeBox" Height="30" Margin="0,8,0,0" IsEditable="True" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MouseButtonXBox" Height="30" />
                            <TextBox x:Name="MouseButtonYBox" Grid.Column="2" Height="30" />
                        </Grid>
                        <Button x:Name="PickMouseButtonCoordinateButton"
                                Margin="0,8,0,0"
                                MinWidth="118"
                                Content="选择屏幕坐标..."
                                Click="PickMouseButtonCoordinate_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MouseMoveEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="MoveModeLabelText" Text="移动模式" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MoveModeBox" Height="30" IsEditable="True" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MoveXBox" Height="30" />
                        <TextBox x:Name="MoveYBox" Grid.Column="2" Height="30" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WheelEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="WheelLabelText" Text="滚轮" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WheelVerticalBox" Height="30" />
                        <TextBox x:Name="WheelHorizontalBox" Grid.Column="2" Height="30" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WindowActivateEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="WindowProcessLabelText" Text="目标进程" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button x:Name="PickWindowTargetButton"
                                DockPanel.Dock="Right"
                                MinWidth="96"
                                Margin="8,0,0,0"
                                Content="选择窗口..."
                                Click="PickWindowTarget_Click" />
                        <TextBox x:Name="WindowProcessBox" Height="30" />
                    </DockPanel>

                    <TextBlock x:Name="WindowTitleLabelText" Text="窗口标题（可选）" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <TextBox x:Name="WindowTitleBox"
                             Height="30"
                             TextChanged="WindowTitleBox_TextChanged" />
                    <CheckBox x:Name="WindowTitleRegexBox"
                              Content="标题使用正则表达式"
                              Margin="0,7,0,0"
                              Checked="WindowTitleRegexBox_Changed"
                              Unchecked="WindowTitleRegexBox_Changed" />
                    <TextBlock x:Name="WindowTitleRegexErrorText"
                               Text="窗口标题正则表达式无效"
                               Foreground="{DynamicResource Danger}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WindowMatchIndexLabelText" Text="第几个匹配窗口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WindowMatchIndexBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="WindowTimeoutLabelText" Text="确认超时 (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WindowTimeoutMsBox" Height="30" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="WindowRestoreBox"
                              Content="最小化时自动恢复"
                              Margin="0,8,0,0"
                              IsChecked="True" />
                    <CheckBox x:Name="WindowFailIfNotFoundBox"
                              Content="切换失败时停止宏"
                              Margin="0,6,0,0"
                              IsChecked="True" />
                    <TextBlock x:Name="WindowActivateStatusText"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="切换后会确认目标进程已经成为前台。" />
                </StackPanel>

                <StackPanel x:Name="OcrExtractTextEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="OcrExtractPresetLabelText" Text="常用规则" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="OcrExtractPresetBox"
                              Height="30"
                              SelectionChanged="OcrExtractPresetBox_SelectionChanged">
                        <ComboBoxItem x:Name="OcrExtractPresetCustomItem" Tag="Custom" Content="自定义" IsSelected="True" />
                        <ComboBoxItem x:Name="OcrExtractPresetAllTextItem" Tag="AllText" Content="获取全部文字" />
                        <ComboBoxItem x:Name="OcrExtractPresetDigitsItem" Tag="Digits" Content="只获取连续数字" />
                        <ComboBoxItem x:Name="OcrExtractPresetFilterDigitsItem" Tag="FilterDigits" Content="先过滤示例词，再只保留数字" />
                        <ComboBoxItem x:Name="OcrExtractPresetAlphaNumericItem" Tag="AlphaNumeric" Content="连续字母、数字、横线或下划线" />
                        <ComboBoxItem x:Name="OcrExtractPresetUidItem" Tag="Uid" Content="获取 UID 后面的内容" />
                        <ComboBoxItem x:Name="OcrExtractPresetAfterSeparatorItem" Tag="AfterSeparator" Content="获取冒号或等号后面的内容" />
                    </ComboBox>

                    <TextBlock x:Name="OcrExtractFilterTermsLabelText"
                               Text="过滤词（每行一个，最先执行）"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="OcrExtractFilterTermsBox"
                             MinHeight="54"
                             MaxHeight="90"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             TextChanged="OcrExtractFilterTermsBox_TextChanged" />
                    <CheckBox x:Name="OcrExtractKeepDigitsOnlyBox"
                              Content="过滤和提取后只保留 0-9"
                              Margin="0,7,0,0"
                              Checked="OcrExtractKeepDigitsOnlyBox_Changed"
                              Unchecked="OcrExtractKeepDigitsOnlyBox_Changed" />

                    <TextBlock x:Name="OcrExtractPatternLabelText" Text="提取规则（留空获取全部文字）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OcrExtractPatternBox"
                             Height="30"
                             TextChanged="OcrExtractPatternBox_TextChanged" />
                    <CheckBox x:Name="OcrExtractRegexBox"
                              Content="使用正则表达式"
                              Margin="0,7,0,0"
                              Checked="OcrExtractRegexBox_Changed"
                              Unchecked="OcrExtractRegexBox_Changed" />
                    <TextBlock x:Name="OcrExtractRegexErrorText"
                               Foreground="{DynamicResource Danger}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"
                               Text="正则表达式无效" />

                    <TextBlock x:Name="OcrExtractRegionLabelText" Text="屏幕识别区域" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <DockPanel>
                        <Button x:Name="PickOcrExtractRegionButton"
                                DockPanel.Dock="Right"
                                MinWidth="96"
                                Content="选择区域..."
                                Click="PickOcrExtractRegion_Click" />
                        <TextBlock x:Name="OcrExtractRegionInfoText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OcrExtractLanguageLabelText" Text="识别语言" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="OcrExtractLanguageBox" Height="30" IsEditable="True">
                                <ComboBoxItem Content="中文 / English" Tag="ch" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="OcrExtractMatchIndexLabelText" Text="第几个匹配" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrExtractMatchIndexBox" Height="30" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="OcrExtractCaptureGroupLabelText"
                               Text="复制捕获组（0=完整匹配）"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="OcrExtractCaptureGroupBox" Height="30" />
                    <CheckBox x:Name="OcrExtractNormalizeWhitespaceBox"
                              Content="匹配失败时忽略 OCR 多余空格"
                              Margin="0,8,0,0"
                              IsChecked="True" />
                    <CheckBox x:Name="OcrExtractFailIfNotFoundBox"
                              Content="未提取到文字时停止宏"
                              Margin="0,6,0,0"
                              IsChecked="True" />

                    <Button x:Name="TestOcrExtractButton"
                            Content="测试提取（不写剪贴板）"
                            Margin="0,9,0,0"
                            Click="TestOcrExtract_Click" />
                    <TextBlock x:Name="OcrExtractStatusText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="OcrClickEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="OcrClickExpectedLabelText" Text="要点击的文字" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OcrClickExpectedTextBox"
                             Height="30"
                             TextChanged="OcrClickExpectedTextBox_TextChanged" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="OcrClickRegexBox"
                                  Content="使用正则表达式"
                                  Margin="0,0,16,0"
                                  Checked="OcrClickRegexBox_Changed"
                                  Unchecked="OcrClickRegexBox_Changed" />
                        <CheckBox x:Name="OcrClickContainsBox" Content="包含匹配" IsChecked="True" />
                    </WrapPanel>
                    <TextBlock x:Name="OcrClickRegexErrorText"
                               Foreground="{DynamicResource Danger}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"
                               Text="正则表达式无效" />

                    <TextBlock x:Name="OcrClickRegionLabelText" Text="屏幕识别区域" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <DockPanel>
                        <Button x:Name="PickOcrClickRegionButton"
                                DockPanel.Dock="Right"
                                MinWidth="96"
                                Content="选择区域..."
                                Click="PickOcrClickRegion_Click" />
                        <TextBlock x:Name="OcrClickRegionInfoText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OcrClickLanguageLabelText" Text="识别语言" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="OcrClickLanguageBox" Height="30" IsEditable="True">
                                <ComboBoxItem Content="中文 / English" Tag="ch" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="OcrClickButtonLabelText" Text="鼠标按键" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="OcrClickMouseButtonBox" Height="30" IsEditable="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OcrClickCountLabelText" Text="点击次数 (1-3)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickCountBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="OcrClickMatchIndexLabelText" Text="第几个匹配" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickMatchIndexBox" Height="30" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OcrClickHoldLabelText" Text="按住 (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickHoldMsBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="OcrClickIntervalLabelText" Text="多击间隔 (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickIntervalMsBox" Height="30" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OcrClickOffsetXLabelText" Text="点击偏移 X" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickOffsetXBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="OcrClickOffsetYLabelText" Text="点击偏移 Y" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OcrClickOffsetYBox" Height="30" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="TestOcrClickButton"
                            Content="测试定位（不点击）"
                            Margin="0,9,0,0"
                            Click="TestOcrClick_Click" />
                    <TextBlock x:Name="OcrClickStatusText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="TimingEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="TimingLabelText" Text="平滑时间（毫秒）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TimingMsBox" Height="30" />
                    <TextBlock x:Name="MouseMoveDurationHintText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="相对移动会先快后慢地滑过去。超过屏幕的长距离会在边缘回中后继续。填 0 仍会分段发出，看起来像一帧拉枪。绝对坐标仍然瞬间到达。" />
                </StackPanel>

                <StackPanel x:Name="DelayEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="DelayModeLabelText" Text="延迟模式" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DelayModeBox" Height="30" SelectionChanged="DelayModeBox_SelectionChanged" IsEditable="False">
                        <ComboBoxItem Content="固定延迟" Tag="Fixed" />
                        <ComboBoxItem Content="随机范围" Tag="Random" />
                    </ComboBox>
                    <StackPanel x:Name="DelayFixedPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="DelayFixedLabelText" Text="延迟（毫秒）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DelayMsBox" Height="30" />
                    </StackPanel>
                    <Grid x:Name="DelayRangePanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DelayMinLabelText" Text="最小 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DelayMinMsBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="DelayMaxLabelText" Text="最大 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DelayMaxMsBox" Height="30" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="TextEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="TextActionLabelText" Text="文本" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="StepTextBox"
                             Height="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             />
                </StackPanel>

                <StackPanel x:Name="LoopEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="LoopCountLabelText" Text="循环次数" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LoopCountBox" Height="30" />
                </StackPanel>

                <StackPanel x:Name="NetLimitEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="NetLimitStopHintText" Text="取消限速，恢复原来的网速。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock x:Name="NetLimitProcessLabelText" Text="进程名" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NetLimitProcessBox" Height="30" />
                    <TextBlock x:Name="NetLimitBytesLabelText" Text="限速 (B/s)" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <TextBox x:Name="NetLimitBytesBox" Height="30" />
                    <TextBlock x:Name="NetLimitHintText" Text="新建时默认 695。只限制上传，下载不限，单位是字节/秒。" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ClockShiftEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="ClockRestoreHintText" Text="立刻把系统时间改回。播放结束时如果还没改回，也会自动改回。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Grid x:Name="ClockShiftRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ClockShiftHoursLabelText" Text="拨快小时" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ClockShiftHoursBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="ClockShiftMinutesLabelText" Text="拨快分钟" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ClockShiftMinutesBox" Height="30" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ClockShiftHintText" Text="填 0 小时 0 分钟则不改系统时间。同一次播放只按第一次拨快。断网卡片仍会默认拨快。" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="WeakNetEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="WeakNetStopHintText" Text="恢复网络。系统时间仍在宏结束时改回。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WeakNetProcessLabelText" Text="进程名" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="WeakNetProcessBox" Height="30" />
                    <TextBlock x:Name="WeakNetDurationLabelText" Text="持续毫秒" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <TextBox x:Name="WeakNetDurationBox" Height="30" />
                    <Grid x:Name="WeakNetShiftRow" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WeakNetShiftHoursLabelText" Text="拨快小时" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WeakNetShiftHoursBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="WeakNetShiftMinutesLabelText" Text="拨快分钟" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WeakNetShiftMinutesBox" Height="30" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WeakNetShiftHintText" Text="填 0 小时 0 分钟则不改系统时间。同一次播放只按第一次拨快，宏结束时改回。" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="FrameLockEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="FrameLockProcessLabelText" Text="进程名" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FrameLockProcessBox" Height="30" />
                    <TextBlock x:Name="FrameLockFpsLabelText" Text="锁定帧数" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <TextBox x:Name="FrameLockFpsBox" Height="30" />
                    <TextBlock x:Name="FrameLockHintText" Text="帧数 1 到 1000。关闭时恢复原来的上限。播放结束也会恢复。" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ParallelEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="ParallelTimeoutLabelText" Text="超时（毫秒，留空直到成立）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ParallelTimeoutBox" Height="30" />
                </StackPanel>

                <StackPanel x:Name="TextWhenEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="TextWhenExpectedLabelText" Text="期望文字" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextWhenExpectedBox" Height="30" />
                    <CheckBox x:Name="TextWhenContainsBox" Content="包含匹配" IsChecked="True" Margin="0,8,0,0" />
                    <CheckBox x:Name="TextWhenRegexBox" Content="正则" Margin="0,4,0,0" />
                    <TextBlock x:Name="TextWhenRegionLabelText" Text="区域（左 上 右 下）" Style="{StaticResource FieldLabel}" Margin="0,9,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TextWhenLeftBox" Height="30" />
                        <TextBox x:Name="TextWhenTopBox" Grid.Column="2" Height="30" />
                        <TextBox x:Name="TextWhenRightBox" Grid.Column="4" Height="30" />
                        <TextBox x:Name="TextWhenBottomBox" Grid.Column="6" Height="30" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PixelEditPanel" Margin="0,0,0,10">
                    <TextBlock x:Name="PixelLabelText" Text="像素条件" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PixelXBox" Height="30" />
                        <TextBox x:Name="PixelYBox" Grid.Column="2" Height="30" />
                        <TextBox x:Name="PixelToleranceBox" Grid.Column="4" Height="30" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PixelRBox" Height="30" />
                        <TextBox x:Name="PixelGBox" Grid.Column="2" Height="30" />
                        <TextBox x:Name="PixelBBox" Grid.Column="4" Height="30" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PixelWindowStartBox" Height="30" />
                        <TextBox x:Name="PixelWindowEndBox" Grid.Column="2" Height="30" />
                        <TextBox x:Name="PixelPollBox" Grid.Column="4" Height="30" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Border x:Name="PixelColorPreview"
                                DockPanel.Dock="Left"
                                Width="34"
                                Height="30"
                                Background="#000000"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="6" />
                        <Button x:Name="PickPixelColorButton"
                                MinWidth="118"
                                Margin="8,0,0,0"
                                Content="取色"
                                Click="PickPixelColor_Click" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

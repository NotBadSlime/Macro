<UserControl x:Class="MacroStudio.Controls.StepSequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MacroStudio.Controls">
    <UserControl.Resources>
        <Style x:Key="StepRowActionButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepRowDeleteActionButton" TargetType="Button" BasedOn="{StaticResource StepRowActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <Style x:Key="StepTableHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StepTableContainer" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleRow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepParameterWell" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Table.IsKey}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="5,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StepTemplate">
            <Border x:Name="StepRow"
                    Background="Transparent"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    MinHeight="38"
                    Padding="8,3"
                    MouseLeftButtonDown="StepRow_MouseLeftButtonDown"
                    MouseLeftButtonUp="StepRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.72*" MaxWidth="58" />
                        <ColumnDefinition Width="1.35*" MaxWidth="116" />
                        <ColumnDefinition Width="2.25*" MaxWidth="184" />
                        <ColumnDefinition Width="3.4*" />
                        <ColumnDefinition Width="51" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="5"
                            Margin="-8,-3"
                            Background="{Binding BackgroundBrush}"
                            Opacity="0.16"
                            IsHitTestVisible="False" />
                    <Border x:Name="HoverOverlay"
                            Grid.ColumnSpan="5"
                            Margin="-8,-3"
                            Background="{DynamicResource ActionHoverOverlay}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Border x:Name="HoverRail"
                            Grid.ColumnSpan="5"
                            Width="2" Margin="-8,-3,0,-3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <ItemsControl ItemsSource="{Binding ConditionBars}"
                                  Width="3" MaxHeight="20"
                                  Margin="-4,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  ClipToBounds="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="3" Height="4" CornerRadius="1"
                                        Margin="0,0,0,1" Background="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StepOrdinal"
                               Text="{Binding StepNumberLabel}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Margin="4,0,6,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Table.Start}"
                               ToolTip="{Binding Table.StartDescription}"
                               AutomationProperties.Name="{Binding Table.StartDescription}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Grid.Column="2" Margin="{Binding TableActionIndent}" VerticalAlignment="Center"
                               LastChildFill="True" ClipToBounds="True">
                        <local:ActionGlyph DockPanel.Dock="Left"
                                           Width="16" Height="16" Margin="0,0,5,0"
                                           Data="{Binding IconGeometry}"
                                           Foreground="{Binding IconBrush}" />
                        <TextBlock x:Name="StepTitleText"
                                   Text="{Binding Table.Action}"
                                   Foreground="{Binding ActionForeground}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Table.Action}"
                                   Margin="0,0,7,0"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="StepTitle_MouseLeftButtonUp" />
                    </DockPanel>
                    <DockPanel Grid.Column="3" LastChildFill="True" ClipToBounds="True"
                               VerticalAlignment="Center" Margin="1,0,4,0"
                               ToolTip="{Binding Table.AccessibleParameter}">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Table.Indicator}"
                                   Foreground="{Binding IconBrush}"
                                   AutomationProperties.Name="{Binding Table.StateDescription}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Table.Indicator}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Style="{StaticResource StepParameterWell}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Table.Parameter}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DockPanel>
                    <StackPanel x:Name="RowActions" Grid.Column="4"
                                Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                                IsEnabled="{Binding AllowDrop, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Opacity="0">
                        <Button x:Name="StepCopyButton"
                                Style="{StaticResource StepRowActionButton}"
                                Width="22" Margin="0,0,2,0"
                                Content="⧉"
                                ToolTip="{Binding TableCopyLabel}"
                                AutomationProperties.Name="{Binding TableCopyLabel}"
                                Click="StepCopy_Click" />
                        <Button x:Name="StepRowDeleteButton"
                                Style="{StaticResource StepRowDeleteActionButton}"
                                Width="22" Margin="0"
                                Content="×"
                                ToolTip="{Binding TableDeleteLabel}"
                                AutomationProperties.Name="{Binding TableDeleteLabel}"
                                Click="StepRowDelete_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="StepRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.5" />
                    <Setter TargetName="RowActions" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="StepRow" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="StepRow" Property="Background" Value="{DynamicResource Selection}" />
                    <Setter TargetName="HoverRail" Property="Opacity" Value="1" />
                    <Setter TargetName="StepOrdinal" Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter TargetName="RowActions" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Index}" Value="-1">
                    <Setter TargetName="RowActions" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConditionEndpoint}" Value="True">
                    <Setter TargetName="StepTitleText" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="StepSequenceRoot"
          ClipToBounds="True"
          PreviewMouseDown="SequenceRoot_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Margin="4,0,4,5">
            <WrapPanel VerticalAlignment="Center" Margin="0,0,12,5">
                <TextBlock x:Name="SequenceTitleText" Text="序列"
                           Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Margin="0,0,8,0"
                           MaxWidth="330" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button x:Name="ZoomOutButton" Style="{StaticResource StepRowActionButton}" Content="−" ToolTip="缩小序列（Ctrl + 滚轮）" Click="ZoomOut_Click" />
                <Button x:Name="SequenceZoomButton" Style="{StaticResource StepRowActionButton}" Width="48" FontSize="12" Content="100%" ToolTip="恢复原始大小" Click="ResetZoom_Click" />
                <Button x:Name="ZoomInButton" Style="{StaticResource StepRowActionButton}" Content="+" ToolTip="放大序列（Ctrl + 滚轮）" Click="ZoomIn_Click" />
            </WrapPanel>
            <Border x:Name="SequenceToolbarGroup"
                    Margin="0,0,0,5"
                    Padding="4"
                    Background="{DynamicResource StudioChrome}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    CornerRadius="11">
                <WrapPanel x:Name="SequenceToolbarButtonStrip">
                    <Button x:Name="ReturnPreviousMacroButton"
                            Style="{StaticResource SequenceToolbarIconButton}"
                            Content="&#xE72B;"
                            ToolTip="{Binding Text, ElementName=ReturnPreviousMacroText}"
                            Click="ReturnPreviousMacro_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="StepUndoButton"
                            Style="{StaticResource SequenceToolbarIconButton}"
                            Content="&#xE7A7;"
                            ToolTip="{Binding Text, ElementName=StepUndoText}"
                            Click="StepUndo_Click"
                            IsEnabled="False" />
                    <Button x:Name="StepRedoButton"
                            Style="{StaticResource SequenceToolbarIconButton}"
                            Content="&#xE7A6;"
                            ToolTip="{Binding Text, ElementName=StepRedoText}"
                            Click="StepRedo_Click"
                            IsEnabled="False" />
                    <Button x:Name="StepUpButton"
                            Style="{StaticResource SequenceToolbarIconButton}"
                            Content="&#xE74A;"
                            ToolTip="{Binding Text, ElementName=StepUpText}"
                            Click="StepUp_Click" />
                    <Button x:Name="StepDownButton"
                            Style="{StaticResource SequenceToolbarIconButton}"
                            Content="&#xE74B;"
                            ToolTip="{Binding Text, ElementName=StepDownText}"
                            Click="StepDown_Click" />
                    <Button x:Name="StepDeleteButton"
                            Style="{StaticResource SequenceToolbarDangerIconButton}"
                            Content="&#xE74D;"
                            ToolTip="{Binding Text, ElementName=StepDeleteText}"
                            Click="StepDelete_Click" />
                    <Button x:Name="StepClearButton"
                            Style="{StaticResource SequenceToolbarDangerIconButton}"
                            Content="&#xE894;"
                            ToolTip="{Binding Text, ElementName=StepClearText}"
                            Click="StepClear_Click" />
                </WrapPanel>
            </Border>
            <TextBlock x:Name="ReturnPreviousMacroText" Text="返回上一宏" Visibility="Collapsed" />
            <TextBlock x:Name="StepUndoText" Text="撤回" Visibility="Collapsed" />
            <TextBlock x:Name="StepRedoText" Text="还原" Visibility="Collapsed" />
            <TextBlock x:Name="StepUpText" Text="上移" Visibility="Collapsed" />
            <TextBlock x:Name="StepDownText" Text="下移" Visibility="Collapsed" />
            <TextBlock x:Name="StepDeleteText" Text="删除" Visibility="Collapsed" />
            <TextBlock x:Name="StepClearText" Text="清空" Visibility="Collapsed" />
        </WrapPanel>

        <Grid Grid.Row="1" PreviewMouseWheel="SequenceViewport_PreviewMouseWheel">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="SequenceScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="StepTableHeader" HorizontalAlignment="Left"
                    Background="{DynamicResource PanelRaised}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.72*" MaxWidth="58" />
                        <ColumnDefinition Width="1.35*" MaxWidth="116" />
                        <ColumnDefinition Width="2.25*" MaxWidth="184" />
                        <ColumnDefinition Width="3.4*" />
                        <ColumnDefinition Width="51" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StepNumberHeading" Style="{StaticResource StepTableHeading}" Text="序号" Margin="4,0,6,0" />
                    <TextBlock x:Name="StepStartHeading" Grid.Column="1" Style="{StaticResource StepTableHeading}" Text="开始" />
                    <TextBlock x:Name="StepActionHeading" Grid.Column="2" Style="{StaticResource StepTableHeading}" Text="动作" />
                    <TextBlock x:Name="StepParameterHeading" Grid.Column="3" Style="{StaticResource StepTableHeading}" Text="参数" Margin="1,0,0,0" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="StepList"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AllowDrop="True"
                         SelectionMode="Extended"
                         ItemTemplate="{StaticResource StepTemplate}"
                         ItemContainerStyle="{StaticResource StepTableContainer}"
                         SelectionChanged="StepList_SelectionChanged"
                         PreviewMouseLeftButtonDown="StepList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="StepList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="StepList_PreviewMouseLeftButtonUp"
                         LostMouseCapture="StepList_LostMouseCapture"
                         DragOver="StepList_DragOver"
                         DragLeave="StepList_DragLeave"
                         Drop="StepList_Drop"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="StepListContextMenu_Opened">
                            <MenuItem x:Name="EnterSubmacroMenuItem"
                                      Header="进入子宏"
                                      Click="EnterSubmacroMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <StackPanel x:Name="EmptySequenceOverlay"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            MaxWidth="290"
                            Margin="12">
                    <Border Width="48" Height="48"
                            Background="{DynamicResource Selection}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="14"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptySequenceOverlayText"
                               Margin="0,10,0,0"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Text="把动作拖到这里，或直接点击右侧添加项。" />
                </StackPanel>
                <Border x:Name="SelectionRectangle"
                        Panel.ZIndex="20"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1"
                        Background="{DynamicResource SelectionBandBrush}"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="DropIndicator"
                        Tag="{StaticResource DropIndicatorPulseStoryboard}"
                        Panel.ZIndex="30"
                        Height="4"
                        Margin="10,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource Accent}"
                        CornerRadius="2"
                        Opacity="0.9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="SelectedStepText"
                   Grid.Row="2"
                   Text="把动作拖到这里，或直接点击右侧添加项。"
                   Foreground="{DynamicResource SecondaryText}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="4,8,4,0" />

        <Popup x:Name="InlineStepEditorPopup"
               Grid.RowSpan="3"
               Placement="Right"
               Closed="InlineStepEditorPopup_Closed"
               Opened="InlineStepEditorPopup_Opened"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border MinWidth="300" MaxWidth="340">
                <local:StepEditorPanel x:Name="InlineStepEditor" />
            </Border>
        </Popup>
    </Grid>
</UserControl>

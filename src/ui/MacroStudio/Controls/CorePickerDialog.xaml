<Window x:Class="MacroStudio.Controls.CorePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择核心"
        Width="640"
        Height="480"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HelpText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}"
                   Margin="0,0,0,10" />
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="6">
            <ListView x:Name="CoreList" SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding ProcessorText}" />
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding PhysicalText}" />
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding KindText}" />
                        <GridViewColumn Width="220" DisplayMemberBinding="{Binding SiblingText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock x:Name="ResultText"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondaryText}" />
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="TestButton"
                    MinWidth="82"
                    HorizontalAlignment="Left"
                    Content="测试"
                    Click="TestButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="82" IsCancel="True" Content="取消" />
                <Button x:Name="ConfirmButton"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Content="确定"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

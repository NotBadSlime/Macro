<Window x:Class="MacroStudio.Controls.MacroBasicControlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宏基础控制"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="16">
            <CheckBox x:Name="BackgroundWindowCheck"
                      Content="后台执行"
                      Margin="0,0,0,8" />
            <TextBlock x:Name="BackgroundProcessLabelText"
                       Text="目标进程"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button x:Name="SelectBackgroundProcessButton"
                        DockPanel.Dock="Right"
                        Width="72"
                        Height="30"
                        Content="选择"
                        Click="SelectBackgroundProcess_Click" />
                <Grid Margin="0,0,8,0">
                    <TextBox x:Name="BackgroundProcessBox"
                             Height="30"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="BackgroundProcessPlaceholderText"
                               Text="与数据库启用进程一致"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BackgroundProcessBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <TextBlock x:Name="BackgroundWindowHelpText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="ColorSampleHotkeyLabelText"
                       Text="取色快捷键"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button x:Name="CaptureColorSampleButton"
                        DockPanel.Dock="Right"
                        Width="72"
                        Height="30"
                        Content="捕获"
                        Click="CaptureColorSample_Click" />
                <TextBox x:Name="ColorSampleHotkeyBox"
                         Height="30"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True" />
            </DockPanel>
            <TextBlock x:Name="ColorSampleHotkeyHelpText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="StopTriggerLabelText"
                       Text="强制停止键"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button x:Name="ClearStopTriggerButton"
                        DockPanel.Dock="Right"
                        Width="72"
                        Height="30"
                        Margin="8,0,0,0"
                        Content="清除"
                        Click="ClearStopTrigger_Click" />
                <Button x:Name="CaptureStopTriggerButton"
                        DockPanel.Dock="Right"
                        Width="72"
                        Height="30"
                        Content="捕获"
                        Click="CaptureStopTrigger_Click" />
                <TextBox x:Name="StopTriggerTextBox"
                         Height="30"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True" />
            </DockPanel>
            <TextBlock x:Name="StopTriggerHintText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="ZeroGapHoldLabelText"
                       Text="默认间隔"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <TextBlock x:Name="ZeroGapUnitText"
                           DockPanel.Dock="Right"
                           Width="48"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="微秒" />
                <TextBox x:Name="ZeroGapHoldBox" Height="30" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="ZeroGapHoldHelpText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="ModifierChordHoldLabelText"
                       Text="组合键间隔"
                       Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <TextBlock x:Name="ModifierChordUnitText"
                           DockPanel.Dock="Right"
                           Width="48"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="微秒" />
                <TextBox x:Name="ModifierChordHoldBox" Height="30" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="ModifierChordHoldHelpText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="CloseButtonLabelText"
                       Text="关闭按钮"
                       Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CloseButtonBox" Height="30" Margin="0,0,0,4">
                <ComboBoxItem Tag="ask" Content="每次询问" />
                <ComboBoxItem Tag="minimizeToTray" Content="最小化到托盘" />
                <ComboBoxItem Tag="exit" Content="退出程序" />
            </ComboBox>
            <TextBlock x:Name="CloseButtonHelpText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="82" IsCancel="True" Content="取消" />
                <Button x:Name="ConfirmButton"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Content="确定"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

<Window x:Class="MacroStudio.Controls.WindowTargetPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择运行窗口"
        Width="680"
        Height="460"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    MinWidth="76"
                    Content="刷新"
                    Click="RefreshButton_Click" />
            <Grid Margin="0,0,8,0">
            <TextBox x:Name="FilterBox"
                     Height="30"
                     ToolTip="筛选进程名或窗口标题"
                     TextChanged="FilterBox_TextChanged" />
            <TextBlock x:Name="FilterPlaceholderText"
                       Text="筛选进程名或窗口标题">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderHintStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="6">
            <Grid>
                <ListBox x:Name="WindowList"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="WindowList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,4" Style="{StaticResource SoftListItemBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProcessName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding WindowTitle}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText"
                           Text="没有可选择的运行窗口"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    MinWidth="82"
                    IsCancel="True"
                    Content="取消" />
            <Button x:Name="SelectButton"
                    MinWidth="82"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Content="选择"
                    Click="SelectButton_Click" />
        </StackPanel>
    </Grid>
</Window>

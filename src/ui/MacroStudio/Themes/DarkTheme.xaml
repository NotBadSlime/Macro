<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="PageBackground" Color="#22211E" />
    <SolidColorBrush x:Key="PanelBackground" Color="#22211E" />
    <SolidColorBrush x:Key="PanelRaised" Color="#282621" />
    <SolidColorBrush x:Key="PanelBorder" Color="#403C32" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F3EFE5" />
    <SolidColorBrush x:Key="SecondaryText" Color="#C0B8AA" />
    <SolidColorBrush x:Key="Accent" Color="#EF9B7B" />
    <SolidColorBrush x:Key="AccentBlue" Color="#A2CEE5" />
    <SolidColorBrush x:Key="AccentOrange" Color="#E2B78E" />
    <SolidColorBrush x:Key="AccentPink" Color="#DBA5AF" />
    <SolidColorBrush x:Key="Danger" Color="#F2A18B" />
    <SolidColorBrush x:Key="Hover" Color="#302B23" />
    <SolidColorBrush x:Key="Selection" Color="#382A22" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#EF9B7B" />
    <SolidColorBrush x:Key="ActionHoverOverlay" Color="#26EF9B7B" />
    <SolidColorBrush x:Key="ChromeBackground" Color="#1D1D1A" />
    <SolidColorBrush x:Key="ChromeBorder" Color="#403C32" />
    <SolidColorBrush x:Key="ControlBackground" Color="#282621" />
    <SolidColorBrush x:Key="ControlBorder" Color="#514437" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#595041" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#827462" />
    <SolidColorBrush x:Key="DisabledText" Color="#B0A392" />
    <SolidColorBrush x:Key="Placeholder" Color="#ABA08E" />
    <SolidColorBrush x:Key="FocusRing" Color="#EF9B7B" />
    <SolidColorBrush x:Key="DangerHover" Color="#473025" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#F5AE93" />
    <SolidColorBrush x:Key="ShellSidebarBackground" Color="#1A1A17" />
    <SolidColorBrush x:Key="WorkbenchBackground" Color="#22211E" />
    <SolidColorBrush x:Key="InspectorBackground" Color="#1D1D1A" />

    <sys:Double x:Key="PanelShadowOpacity">0</sys:Double>
    <sys:Double x:Key="PanelShadowBlur">0</sys:Double>

    <SolidColorBrush x:Key="BadgeBlue" Color="#252A29" />
    <SolidColorBrush x:Key="BadgeAmber" Color="#322B23" />
    <SolidColorBrush x:Key="BadgeGray" Color="#2A2924" />
    <SolidColorBrush x:Key="BadgeGreen" Color="#272C24" />
    <SolidColorBrush x:Key="BadgePurple" Color="#2D2828" />
    <SolidColorBrush x:Key="BadgePink" Color="#342827" />
    <SolidColorBrush x:Key="BadgeTeal" Color="#262B27" />
    <SolidColorBrush x:Key="BadgeRed" Color="#362A25" />
    <SolidColorBrush x:Key="BadgeMint" Color="#282D25" />
    <SolidColorBrush x:Key="BadgeOrange" Color="#352B20" />
    <SolidColorBrush x:Key="WorkspacePanelGlowBrush" Color="#26EF9B7B" />
    <SolidColorBrush x:Key="RailSelectionGlow" Color="#15EF9B7B" />
    <SolidColorBrush x:Key="SelectionBandBrush" Color="#33EF9B7B" />
    <SolidColorBrush x:Key="StudioPrimaryFill" Color="#EF9B7B" />
    <SolidColorBrush x:Key="StudioPrimaryInk" Color="#27231D" />
    <SolidColorBrush x:Key="StudioSuccess" Color="#A2C19E" />
    <SolidColorBrush x:Key="StudioDimmer" Color="#A2141311" />
    <SolidColorBrush x:Key="StudioSignal" Color="#EF9B7B" />

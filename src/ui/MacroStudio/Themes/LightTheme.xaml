<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="PageBackground" Color="#E1E5EA" />
    <SolidColorBrush x:Key="PanelBackground" Color="#EBEEF1" />
    <SolidColorBrush x:Key="PanelRaised" Color="#F1F2F4" />
    <SolidColorBrush x:Key="PanelBorder" Color="#C8CED6" />
    <SolidColorBrush x:Key="PrimaryText" Color="#252A31" />

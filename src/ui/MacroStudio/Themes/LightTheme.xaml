<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="PageBackground" Color="#FCFBF8" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FCFBF8" />
    <SolidColorBrush x:Key="PanelRaised" Color="#FFFDF9" />
    <SolidColorBrush x:Key="PanelBorder" Color="#DFD9CD" />
    <SolidColorBrush x:Key="PrimaryText" Color="#27231D" />
    <SolidColorBrush x:Key="SecondaryText" Color="#655E50" />
    <SolidColorBrush x:Key="Accent" Color="#A73522" />
    <SolidColorBrush x:Key="AccentBlue" Color="#315984" />
    <SolidColorBrush x:Key="AccentOrange" Color="#8C5127" />
    <SolidColorBrush x:Key="AccentPink" Color="#87374A" />
    <SolidColorBrush x:Key="Danger" Color="#9E3926" />
    <SolidColorBrush x:Key="Hover" Color="#EFEAE2" />
    <SolidColorBrush x:Key="Selection" Color="#F3E4D9" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#A73522" />
    <SolidColorBrush x:Key="ActionHoverOverlay" Color="#239F5639" />
    <SolidColorBrush x:Key="ChromeBackground" Color="#F6F4EF" />
    <SolidColorBrush x:Key="ChromeBorder" Color="#DFD9CD" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFDF9" />
    <SolidColorBrush x:Key="ControlBorder" Color="#D5CDBD" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C6BDAD" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9E9381" />
    <SolidColorBrush x:Key="DisabledText" Color="#827769" />
    <SolidColorBrush x:Key="Placeholder" Color="#796F62" />
    <SolidColorBrush x:Key="FocusRing" Color="#A73522" />
    <SolidColorBrush x:Key="DangerHover" Color="#F8E5DD" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#8D2A1B" />
    <SolidColorBrush x:Key="ShellSidebarBackground" Color="#EFEDE6" />
    <SolidColorBrush x:Key="WorkbenchBackground" Color="#FCFBF8" />
    <SolidColorBrush x:Key="InspectorBackground" Color="#F6F4EF" />

    <sys:Double x:Key="PanelShadowOpacity">0</sys:Double>
    <sys:Double x:Key="PanelShadowBlur">0</sys:Double>

    <SolidColorBrush x:Key="BadgeBlue" Color="#EEF0ED" />
    <SolidColorBrush x:Key="BadgeAmber" Color="#F2EBDD" />
    <SolidColorBrush x:Key="BadgeGray" Color="#EFEDE6" />
    <SolidColorBrush x:Key="BadgeGreen" Color="#EBEEE5" />
    <SolidColorBrush x:Key="BadgePurple" Color="#EFEAE7" />
    <SolidColorBrush x:Key="BadgePink" Color="#F2E7E5" />
    <SolidColorBrush x:Key="BadgeTeal" Color="#E7EEE9" />
    <SolidColorBrush x:Key="BadgeRed" Color="#F3E7E0" />
    <SolidColorBrush x:Key="BadgeMint" Color="#E9EEE6" />
    <SolidColorBrush x:Key="BadgeOrange" Color="#F2E7DA" />
    <SolidColorBrush x:Key="WorkspacePanelGlowBrush" Color="#24A73522" />
    <SolidColorBrush x:Key="RailSelectionGlow" Color="#10A73522" />
    <SolidColorBrush x:Key="SelectionBandBrush" Color="#28A73522" />
    <SolidColorBrush x:Key="StudioPrimaryFill" Color="#A73522" />
    <SolidColorBrush x:Key="StudioPrimaryInk" Color="#FFFDF8" />
    <SolidColorBrush x:Key="StudioSuccess" Color="#32634A" />
    <SolidColorBrush x:Key="StudioDimmer" Color="#883B3328" />
    <SolidColorBrush x:Key="StudioSignal" Color="#A73522" />
    <SolidColorBrush x:Key="StudioChromeEdge" Color="#DFD9CD" />
    <SolidColorBrush x:Key="StudioToolbarSurface" Color="#F6F4EF" />
    <SolidColorBrush x:Key="StudioStatusSurface" Color="#FCFBF8" />
    <SolidColorBrush x:Key="StudioBrandMark" Color="#F4AA8E" />
    <SolidColorBrush x:Key="StudioBrandSurface" Color="#27231D" />
    <SolidColorBrush x:Key="StudioHorizon" Color="#DFD9CD" />
    <SolidColorBrush x:Key="StudioBackdropGrid" Color="Transparent" />

    <Color x:Key="StudioWashStart">#EFEDE6</Color>
    <Color x:Key="StudioWashMiddle">#FCFBF8</Color>
    <Color x:Key="StudioWashEnd">#F6F4EF</Color>
    <Color x:Key="StudioChromeEnd">#F6F4EF</Color>

    <SolidColorBrush x:Key="StudioBackdrop" Color="{StaticResource StudioWashMiddle}" />
    <SolidColorBrush x:Key="StudioChrome" Color="{StaticResource StudioChromeEnd}" />
    <SolidColorBrush x:Key="StudioRailSurface" Color="{StaticResource StudioWashStart}" />
    <SolidColorBrush x:Key="StudioPanelHeaderSurface" Color="{StaticResource StudioWashEnd}" />
</ResourceDictionary>
